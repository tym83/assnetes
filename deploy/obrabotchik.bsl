// Обработчик: среда исполнения операторов на языке 1С и обработки, которые
// идут с дистрибутивом.
//
//   1сctl провести --файл deploy/obrabotchik.bsl --параметр Подразделение=assnetes
//
// Параметры:
//   Подразделение — куда ставить (по умолчанию assnetes);
//   Образ         — образ обработчика;
//   Обработки     — какие из /obrabotki включить, через запятую (по умолчанию все).

Функция Параметр(Имя, ПоУмолчанию)
	Значение = Неопределено;
	Если Параметры.Свойство(Имя, Значение) И ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Подразделение = Параметр("Подразделение", "assnetes");
Образ = Параметр("Образ", "ghcr.io/tym83/assnetes-obrabotchik:main");
Обработки = Параметр("Обработки", "proizvodstvennyj-kalendar,kursy-valyut,data-zapreta,udalenie-pomechennyh,akt-sverki");

Провести(Новый Подразделение(Подразделение));

Провести(Новый ПодотчётноеЛицо("обработчик", Подразделение));

// Обработки получают Кластер целиком: они и есть платформа.
Назначение = Новый НазначениеРолиКластера("обработчик-" + Подразделение);
Назначение.СсылкаНаРоль.ГруппаAPI = "rbac.authorization.k8s.io";
Назначение.СсылкаНаРоль.Вид = "ClusterRole";
Назначение.СсылкаНаРоль.Имя = "cluster-admin";
Субъект = Назначение.Субъекты.Добавить();
Субъект.Вид = "ServiceAccount";
Субъект.Имя = "обработчик";
Субъект.Подразделение = Подразделение;
Провести(Назначение);

Развёртывание = Новый Развёртывание("обработчик", Подразделение);
Развёртывание.Метаданные.Метки.Вставить("приложение", "обработчик");
Развёртывание.Спецификация.Реплики = 2; // второй ждёт монопольного режима
Развёртывание.Спецификация.Отбор.ПоМеткам.Вставить("приложение", "обработчик");
Шаблон = Развёртывание.Спецификация.Шаблон;
Шаблон.Метаданные.Метки.Вставить("приложение", "обработчик");
Шаблон.Спецификация.ПодотчётноеЛицо = "обработчик";

Контейнер = Шаблон.Спецификация.Контейнеры.Добавить();
Контейнер.Имя = "обработчик";
Контейнер.Образ = Образ;
Контейнер.Аргументы.Добавить("--service=obrabotchik");
Контейнер.Аргументы.Добавить("--namespace=" + ИмяAPI(Подразделение));
Для Каждого Обработка Из СтрРазделить(Обработки, ",", Ложь) Цикл
	Контейнер.Аргументы.Добавить("/obrabotki/" + СокрЛП(Обработка));
КонецЦикла;
Контейнер.Ресурсы.Запросы.Процессор = "50m";
Контейнер.Ресурсы.Запросы.Память = "64Mi";
Контейнер.Ресурсы.Пределы.Память = "256Mi";
Порт = Контейнер.Порты.Добавить();
Порт.Имя = "proverki";
Порт.ПортКонтейнера = 9443;
Живость = Контейнер.ПробаЖивости.HTTPЗапрос;
Живость.Путь = "/healthz";
Живость.Порт = 8081;
Готовность = Контейнер.ПробаГотовности.HTTPЗапрос;
Готовность.Путь = "/readyz";
Готовность.Порт = 8081;
Провести(Развёртывание);

Услуга = Новый Услуга("obrabotchik", Подразделение);
Услуга.Спецификация.Отбор.Вставить("приложение", "обработчик");
ПортУслуги = Услуга.Спецификация.Порты.Добавить();
ПортУслуги.Порт = 443;
ПортУслуги.ЦелевойПорт = 9443;
Провести(Услуга);
