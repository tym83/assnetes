// Витрина бухгалтерии: веб-сервер в подразделении «Ромашка».

#Область Подразделение

Ромашка = Новый Подразделение("Ромашка");
Провести(Ромашка);

#КонецОбласти

#Область Витрина

Развёртывание = Новый Развёртывание("Витрина", "Ромашка");
Развёртывание.Метаданные.Метки.Вставить("приложение", "витрина");
Развёртывание.Спецификация.Реплики = 2;
Развёртывание.Спецификация.Отбор.ПоМеткам.Вставить("приложение", "витрина");
Развёртывание.Спецификация.Шаблон.Метаданные.Метки.Вставить("приложение", "витрина");

Контейнер = Развёртывание.Спецификация.Шаблон.Спецификация.Контейнеры.Добавить();
Контейнер.Имя = "веб";
Контейнер.Образ = "nginx:1.29-alpine";
Контейнер.Ресурсы.Запросы.Процессор = "50m";
Контейнер.Ресурсы.Запросы.Память = "32Mi";
Контейнер.Ресурсы.Пределы.Память = "64Mi";
Порт = Контейнер.Порты.Добавить();
Порт.ПортКонтейнера = 80;

Провести(Развёртывание);

Услуга = Новый Услуга("Витрина", "Ромашка");
Услуга.Спецификация.Отбор.Вставить("приложение", "витрина");
ПортУслуги = Услуга.Спецификация.Порты.Добавить();
ПортУслуги.Порт = 80;
ПортУслуги.ЦелевойПорт = 80;
Провести(Услуга);

#КонецОбласти
