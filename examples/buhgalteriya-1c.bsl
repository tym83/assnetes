	|");
Шаблоны.Данные.Вставить("buhgalteriya-3.0.203.11.cfu", "Имя: БухгалтерияПредприятия
	|Синоним: Бухгалтерия предприятия, редакция 3.0
	|Версия: 3.0.203.11
	|Поставщик: Фирма ""1С"" (заглушка)
	|");
Провести(Шаблоны);

ИБ = Новый ИнформационнаяБаза("Бухгалтерия", "Бухгалтерия");
ИБ.Спецификация.КластерСерверов = "Основной";
