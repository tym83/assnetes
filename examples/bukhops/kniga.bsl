// БухОпс: главная книга и люди, которые в неё пишут.
//
//   1сctl провести --файл examples/bukhops/kniga.bsl
//
// Книга живёт в «Бухгалтерии», документы, которые она проводит, — в
// «Ромашке». Леночка и Димон составляют операции, Тамара Петровна их
// утверждает: вторую подпись в этой книге ставит только она.

Провести(Новый Подразделение("Бухгалтерия"));
Провести(Новый Подразделение("Ромашка"));

Книга = Новый ГлавнаяКнига("Основная", "Бухгалтерия");
Книга.Спецификация.Подразделение = "Ромашка";
Книга.Спецификация.ИнтервалРазноски = "1m";
Книга.Спецификация.Подписанты.Добавить("tamara.petrovna");

Счёт = Книга.Спецификация.ПланСчетов.Добавить();
Счёт.Код = "01";
Счёт.Наименование = "Основные средства";
Счёт.Вид = "Активный";

Счёт = Книга.Спецификация.ПланСчетов.Добавить();
Счёт.Код = "80";
Счёт.Наименование = "Уставный капитал";
Счёт.Вид = "Пассивный";

Провести(Книга);

// Права: бухгалтеры составляют операции, главбух ещё и подписывает и
// закрывает период. Править и удалять операции RBAC разрешает — не
// разрешает книга.
// группа «оркестратор.бух», как её пишет API
ГруппаКниги = "xn--80ajopdiccfkc.xn--90a0bg";

Бухгалтер = Новый Роль("buhgalter", "Бухгалтерия");
Правило = Бухгалтер.Правила.Добавить();
Правило.ГруппыAPI.Добавить(ГруппаКниги);
Правило.Ресурсы.Добавить("operations");
Для Каждого Действие Из СтрРазделить("get,list,watch,create,patch,update,delete", ",") Цикл
	Правило.Действия.Добавить(Действие);
КонецЦикла;
Правило = Бухгалтер.Правила.Добавить();
Правило.ГруппыAPI.Добавить(ГруппаКниги);
Правило.Ресурсы.Добавить("ledgers");
Для Каждого Действие Из СтрРазделить("get,list,watch", ",") Цикл
	Правило.Действия.Добавить(Действие);
КонецЦикла;
Провести(Бухгалтер);

Главбух = Новый Роль("glavbuh", "Бухгалтерия");
Правило = Главбух.Правила.Добавить();
Правило.ГруппыAPI.Добавить(ГруппаКниги);
Правило.Ресурсы.Добавить("operations");
Правило.Ресурсы.Добавить("ledgers");
Для Каждого Действие Из СтрРазделить("get,list,watch,create,patch,update,delete", ",") Цикл
	Правило.Действия.Добавить(Действие);
КонецЦикла;
Провести(Главбух);

Для Каждого Сотрудник Из СтрРазделить("lenochka:buhgalter,dimon:buhgalter,tamara.petrovna:glavbuh", ",") Цикл
	Части = СтрРазделить(Сотрудник, ":");
	Назначение = Новый НазначениеРоли(Части[0], "Бухгалтерия");
	Назначение.СсылкаНаРоль.ГруппаAPI = "rbac.authorization.k8s.io";
	Назначение.СсылкаНаРоль.Вид = "Role";
	Назначение.СсылкаНаРоль.Имя = Части[1];
	Субъект = Назначение.Субъекты.Добавить();
	Субъект.Вид = "User";
	Субъект.ГруппаAPI = "rbac.authorization.k8s.io";
	Субъект.Имя = Части[0];
	Провести(Назначение);
КонецЦикла;
