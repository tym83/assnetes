// Сентябрь. Витрину приняли к учёту: две реплики в основные средства за
// счёт уставного капитала. Первичка — манифест витрины, реплик в нём
// столько, сколько по счёту 01 на субконто «Витрина».

Операция = Новый Операция("БП-000001", "Бухгалтерия");
Операция.Спецификация.Книга = "Основная";
Операция.Спецификация.Дата = "2026-09-01";
Операция.Спецификация.Содержание = "Принята к учёту витрина";

Проводка = Операция.Спецификация.Проводки.Добавить();
Проводка.Дт = "01/Витрина";
Проводка.Кт = "80";
Проводка.Сумма = 2;

Операция.Спецификация.Первичка =
"Развёртывание = Новый Развёртывание(""Витрина"");
|Развёртывание.Метаданные.Метки.Вставить(""приложение"", ""витрина"");
|Развёртывание.Спецификация.Реплики = Сальдо(""01/Витрина"");
|Развёртывание.Спецификация.Отбор.ПоМеткам.Вставить(""приложение"", ""витрина"");
|Развёртывание.Спецификация.Шаблон.Метаданные.Метки.Вставить(""приложение"", ""витрина"");
|Контейнер = Развёртывание.Спецификация.Шаблон.Спецификация.Контейнеры.Добавить();
|Контейнер.Имя = ""веб"";
|Контейнер.Образ = ""nginx:1.29-alpine"";
|Контейнер.Ресурсы.Запросы.Процессор = ""10m"";
|Провести(Развёртывание);";

Провести(Операция);
