// Акт сверки.
//
// Сверяет объекты кластера с манифестами в Git — «данными контрагента» — и
// составляет акт сверки взаиморасчётов: что сошлось, что разошлось и в каких
// полях. Ничего не правит: акт подписывают люди.

#Область ОбработчикиСобытий

&Обработка(Вид = "АктСверки")
Процедура ОбработкаПроведения(Объект, Отказ) Экспорт

	Спецификация = Объект.Спецификация;
	Период = ?(ЗначениеЗаполнено(Спецификация.ПериодичностьМинут), Спецификация.ПериодичностьМинут, 10);
	ПовторитьЧерез(Период * 60);

	Параметры = Новый Структура;
	Для Каждого Параметр Из Спецификация.Параметры Цикл
		Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Документы = Новый Массив;
	Для Каждого Файл Из Спецификация.Файлы Цикл
		Попытка
			Текст = ПолучитьФайл(Спецификация.Источник, Файл);
			Для Каждого Документ Из ВыполнитьМанифест(Текст, Параметры) Цикл
				Документы.Добавить(Документ);
			КонецЦикла;
		Исключение
			Отказ = Истина;
			Сообщить(СтрШаблон("Первичка «%1» не читается: %2", Файл, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Возврат;
		КонецПопытки;
	КонецЦикла;

	Расхождения = Новый Массив;
	Для Каждого Документ Из Документы Цикл
		СверитьДокумент(Документ, Спецификация.Подразделение, Расхождения);
	КонецЦикла;

	Состояние = Объект.Состояние;
	Состояние.ДатаСверки = XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z";
	Состояние.Сверено = Документы.Количество();
	Состояние.Расхождений = Расхождения.Количество();
	Состояние.Сошлось = (Расхождения.Количество() = 0);
	Показать = Новый Массив;
	Для Каждого Расхождение Из Расхождения Цикл
		Если Показать.Количество() = 50 Тогда
			Прервать;
		КонецЕсли;
		Показать.Добавить(Расхождение);
	КонецЦикла;
	Состояние.Расхождения = Показать;
	Состояние.Акт = ТекстАкта(Спецификация.Источник, Документы.Количество(), Расхождения);
	Состояние.Сообщение = ?(Состояние.Сошлось,
		СтрШаблон("Сверено документов: %1. Расхождений нет.", Документы.Количество()),
		СтрШаблон("Сверено документов: %1. Расхождений: %2. Акт к подписанию не готов.", Документы.Количество(), Расхождения.Количество()));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьФайл(Источник, Файл)

	Если СтрНачинаетсяС(НРег(Источник), "справочник:") Тогда
		Части = СтрРазделить(Сред(Источник, СтрДлина("справочник:") + 1), "/");
		Если Части.Количество() <> 2 Тогда
			ВызватьИсключение "источник «справочник:» записывается как справочник:Подразделение/Имя";
		КонецЕсли;
		Справочник = Кластер.Получить("Справочник", Части[1], Части[0]);
		Если Справочник = Неопределено Тогда
			ВызватьИсключение СтрШаблон("справочник «%1» не найден", Части[1]);
		КонецЕсли;
		Текст = Справочник.Данные.Получить(Файл);
		Если Текст = Неопределено Тогда
			ВызватьИсключение СтрШаблон("в справочнике нет файла «%1»", Файл);
		КонецЕсли;
		Возврат Текст;
	КонецЕсли;

	Соединение = Новый HTTPСоединение(Источник, , , , , 30);
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/" + Файл));
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("код ответа %1", Ответ.КодСостояния);
	КонецЕсли;
	Возврат Ответ.ПолучитьТелоКакСтроку();

КонецФункции

Процедура СверитьДокумент(Документ, ПодразделениеПоУмолчанию, Расхождения)

	Вид = Документ.Вид;
	Имя = Документ.Метаданные.Имя;
	Подразделение = Документ.Метаданные.Подразделение;
	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Подразделение = ПодразделениеПоУмолчанию;
	КонецЕсли;
	Представление = СтрШаблон("%1 «%2»", Вид, Имя);

	Наш = Кластер.Получить(Вид, Имя, Подразделение);
	Если Наш = Неопределено Тогда
		Расхождения.Добавить(Новый Структура("Документ, Поле, ДанныеКонтрагента, НашиДанные",
			Представление, "весь документ", "есть", "нет"));
		Возврат;
	КонецЕсли;

	Для Каждого Поле Из Документ Цикл
		Если Поле.Ключ = "Вид" ИЛИ Поле.Ключ = "ВерсияAPI" ИЛИ Поле.Ключ = "Состояние" Тогда
			Продолжить;
		КонецЕсли;
		Сверить(Представление, Поле.Ключ, Поле.Значение, Наш.Получить(Поле.Ключ), Расхождения);
	КонецЦикла;

КонецПроцедуры

// Сравнивает то, что в первичке контрагента, с нашим. Лишнее у нас — не
// расхождение: значения по умолчанию кластер дописывает сам.
Процедура Сверить(Документ, Путь, Их, Наше, Расхождения)

	Если ТипЗнч(Их) = Тип("ОбъектКластера") Тогда
		Если ТипЗнч(Наше) <> Тип("ОбъектКластера") Тогда
			Добавить(Расхождения, Документ, Путь, "заполнено", "нет");
			Возврат;
		КонецЕсли;
		Если Путь = "Метаданные" Тогда
			Сверить(Документ, Путь + ".Метки", Их.Метки, Наше.Метки, Расхождения);
			Возврат; // имя и подразделение уже совпали, служебное не сверяем
		КонецЕсли;
		Для Каждого Поле Из Их Цикл
			Сверить(Документ, Путь + "." + Поле.Ключ, Поле.Значение, Наше.Получить(Поле.Ключ), Расхождения);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Их) = Тип("СписокОбъектаКластера") Тогда
		Если ТипЗнч(Наше) <> Тип("СписокОбъектаКластера") ИЛИ Наше.Количество() <> Их.Количество() Тогда
			Добавить(Расхождения, Документ, Путь,
				СтрШаблон("%1 шт.", Их.Количество()),
				?(ТипЗнч(Наше) = Тип("СписокОбъектаКластера"), СтрШаблон("%1 шт.", Наше.Количество()), "нет"));
			Возврат;
		КонецЕсли;
		Для Номер = 0 По Их.Количество() - 1 Цикл
			Сверить(Документ, СтрШаблон("%1[%2]", Путь, Номер), Их[Номер], Наше[Номер], Расхождения);
		КонецЦикла;
	ИначеЕсли XMLСтрока(Их) <> XMLСтрока(Наше) Тогда
		Добавить(Расхождения, Документ, Путь, XMLСтрока(Их), ?(Наше = Неопределено, "нет", XMLСтрока(Наше)));
	КонецЕсли;

КонецПроцедуры

Процедура Добавить(Расхождения, Документ, Поле, ДанныеКонтрагента, НашиДанные)

	Расхождения.Добавить(Новый Структура("Документ, Поле, ДанныеКонтрагента, НашиДанные",
		Документ, Поле, ДанныеКонтрагента, НашиДанные));

КонецПроцедуры

Функция ТекстАкта(Источник, Сверено, Расхождения)

	Строки = Новый Массив;
	Строки.Добавить("АКТ СВЕРКИ");
	Строки.Добавить("взаимных расчётов по состоянию на " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DD"));
	Строки.Добавить("между кластером (далее — «мы») и репозиторием " + Источник + " (далее — «контрагент»)");
	Строки.Добавить("");
	Строки.Добавить(СтрШаблон("Сверено документов: %1", Сверено));
	Если Расхождения.Количество() = 0 Тогда
		Строки.Добавить("Расхождений не выявлено. Сальдо на конец периода: 0.");
	Иначе
		Строки.Добавить("№ | Документ | Поле | По данным контрагента | По нашим данным");
		Номер = 0;
		Для Каждого Р Из Расхождения Цикл
			Номер = Номер + 1;
			Строки.Добавить(СтрШаблон("%1 | %2 | %3 | %4 | %5", Номер, Р.Документ, Р.Поле, Р.ДанныеКонтрагента, Р.НашиДанные));
		КонецЦикла;
		Строки.Добавить(СтрШаблон("Сальдо на конец периода: расхождений %1, в пользу контрагента.", Расхождения.Количество()));
	КонецЕсли;
	Строки.Добавить("");
	Строки.Добавить("От кластера: Главный бухгалтер ______________ /Т. П./");
	Строки.Добавить("От контрагента: __________________ /           /");
	Строки.Добавить("М. П.");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти
