Процедура ШаблонТома(Спец, Имя, Объём, Класс)

	Заявка = Спец.ШаблоныЗаявок.Добавить();
	Заявка.Метаданные.Имя = Имя;
	Заявка.Спецификация.РежимыДоступа.Добавить("ReadWriteOnce");
	Заявка.Спецификация.Ресурсы.Запросы.Объём = Объём;
	Если ЗначениеЗаполнено(Класс) Тогда
		Заявка.Спецификация.КлассХранения = Класс;
	КонецЕсли;

