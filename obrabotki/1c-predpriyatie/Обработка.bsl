// 1С:Предприятие в кластере.
//
// Ведёт кластер серверов 1С: центральный сервер с агентом и сервером
// администрирования, рабочие серверы, которые регистрирует в кластере и
// увольняет, дождавшись конца сеансов, лимиты памяти рабочих процессов,
// СУБД на CloudNativePG; информационные базы, их публикации, выгрузки и
// обновления конфигурации с блокировкой сеансов.
//
// Платформу фирма «1С» распространять не разрешает: в «Поставке» указывается
// свой архив. Без него можно проверить всё на заглушке Assnetes, которая
// отвечает как ragent, rac и ibcmd.

#Область ОбработчикиСобытий

&Обработка(Вид = "КластерСерверов", Владеет = "НаборСоСостоянием, Услуга, ЗаявкаНаТом, postgresql.cnpg.io/v1/Cluster", Наблюдает = "Поставка")
Процедура ОбработкаПроведения(Объект, Отказ) Экспорт

	К = ПараметрыКластера(Объект);
	Состояние = Объект.Состояние;

	Поставка = Кластер.Получить("Поставка", К.Поставка);
	Если Поставка = Неопределено ИЛИ НЕ ПоставкаГотова(Поставка) Тогда
		Состояние.Фаза = "ОжидаетПоставку";
		Состояние.Сообщение = СтрШаблон("Поставка «%1» не готова: %2", К.Поставка,
			?(Поставка = Неопределено, "её нет. Без первички не проведу.", Поставка.Состояние.Сообщение));
		ПовторитьЧерез(60);
		Возврат;
	КонецЕсли;
	К.Вставить("Образ", ОбразСервера(Поставка));
	К.Вставить("Заглушка", Поставка.Спецификация.Заглушка = Истина);
	К.Вставить("Путь", ПутьПлатформы(Поставка));
	К.Вставить("Архив", Значение(Поставка.Спецификация.Архив, ""));
	К.Вставить("ОбразСУБД", Значение(Поставка.Спецификация.ОбразСУБД, ""));

	ПровестиСУБД(Объект, К);
	ПровестиУслуги(Объект, К);
	ПровестиЦентральный(Объект, К);

	Если НЕ ПодГотов(К.Имя + "-central-0", К.Подразделение) Тогда
		Состояние.Фаза = "Запуск";
		Состояние.Сообщение = "Центральный сервер запускается. Ждите, программа обновляется — не выключайте компьютер.";
		ПровестиРабочие(Объект, К, К.Рабочих);
		ПовторитьЧерез(15);
		Возврат;
	КонецЕсли;

	Попытка
		КластерИД = ИдентификаторКластера(К);
		Состояние.Кластер = КластерИД;
		Серверы = РазобратьRAC(RAC(К, "server list --cluster=" + КластерИД));
		Процессы = РазобратьRAC(RAC(К, "process list --cluster=" + КластерИД));
		Сеансы = РазобратьRAC(RAC(К, "session list --cluster=" + КластерИД));
	Исключение
		Отказ = Истина;
		Состояние.Фаза = "Ошибка";
		Состояние.Сообщение = "Сервер администрирования не отвечает: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщить(Состояние.Сообщение);
		ПовторитьЧерез(30);
		Возврат;
	КонецПопытки;

	Желаемо = ЖелаемоРабочих(К, Сеансы.Количество());
	Состояние.РабочихЖелаемо = Желаемо;
	Желаемо = ОграничитьЛицензиями(Объект, К, Желаемо);

	// Набор рабочих не уменьшается, пока лишние серверы не уволены.
	Увольняемых = УволитьЛишних(К, КластерИД, Серверы, Процессы, Сеансы, Желаемо);
	ПровестиРабочие(Объект, К, Желаемо + Увольняемых);
	ПринятьНовых(К, КластерИД, Серверы, Желаемо);
	ВыставитьЛимитыПамяти(К, КластерИД, Серверы);

	Серверы = РазобратьRAC(RAC(К, "server list --cluster=" + КластерИД));
	ЗаполнитьСостояние(Объект, К, Серверы, Процессы, Сеансы, Желаемо);
	ПовторитьЧерез(30);

КонецПроцедуры

#КонецОбласти

#Область Поставка

Функция ПоставкаГотова(Поставка)

	Если Поставка.Спецификация.Заглушка = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Поставка.Спецификация.Архив) И ЗначениеЗаполнено(Поставка.Спецификация.Образ);

КонецФункции

Функция ОбразСервера(Поставка)

	Если ЗначениеЗаполнено(Поставка.Спецификация.Образ) Тогда
		Возврат Поставка.Спецификация.Образ;
	КонецЕсли;
	Возврат "ghcr.io/tym83/assnetes-1c-zaglushka:main";

КонецФункции

Функция ПутьПлатформы(Поставка)

	Если Поставка.Спецификация.Заглушка = Истина Тогда
		Возврат "/opt/1cv8/current";
	КонецЕсли;
	Возврат "/opt/1cv8/x86_64/" + Поставка.Спецификация.Версия;

КонецФункции

// «Поставка»: в порядке ли первичка — указан ли архив платформы.
&Обработка(Вид = "Поставка")
Процедура ПоставкаОбработкаПроведения(Объект, Отказ) Экспорт

	Состояние = Объект.Состояние;
	Состояние.Путь = ПутьПлатформы(Объект);
	Если Объект.Спецификация.Заглушка = Истина Тогда
		Состояние.Готова = Истина;
		Состояние.Сообщение = "Заглушка Assnetes вместо платформы: всё, кроме форм, как у настоящей 1С.";
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Спецификация.Архив) Тогда
		Состояние.Готова = Ложь;
		Состояние.Сообщение = "Не обнаружен дистрибутив платформы. Скачайте архив для Linux (developer.1c.ru — лицензия для разработчиков, или releases.1c.ru по ИТС), выложите у себя и укажите адрес в реквизите Архив.";
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Спецификация.Образ) Тогда
		Состояние.Готова = Ложь;
		Состояние.Сообщение = "Не указан образ-основа: ghcr.io/tym83/assnetes-1c-osnova с библиотеками, которые нужны платформе.";
	Иначе
		Состояние.Готова = Истина;
		Состояние.Сообщение = "Платформа " + Объект.Спецификация.Версия + " ставится из архива при запуске серверов.";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Кластер

Функция ПараметрыКластера(Объект)

	Спец = Объект.Спецификация;
	К = Новый Структура;
	К.Вставить("Имя", ИмяAPI(Объект.Метаданные.Имя));
	К.Вставить("Подразделение", Объект.Метаданные.Подразделение);
	К.Вставить("Поставка", Спец.Поставка);
	К.Вставить("ПроцессорЦентрального", Значение(Спец.Центральный.Процессор, "500m"));
	К.Вставить("ПамятьЦентрального", Значение(Спец.Центральный.Память, "2Gi"));
	Рабочие = Спец.РабочиеСерверы;
	К.Вставить("Рабочих", ?(Рабочие.Свойство("Количество"), Рабочие.Количество, 1));
	К.Вставить("Процессор", Значение(Рабочие.Процессор, "1"));
	К.Вставить("Память", Значение(Рабочие.Память, "4Gi"));
	К.Вставить("ИБНаПроцесс", Значение(Рабочие.ИнформационныхБазНаПроцесс, 8));
	К.Вставить("СоединенийНаПроцесс", Значение(Рабочие.СоединенийНаПроцесс, 256));
	К.Вставить("ДоляПамяти", Значение(Рабочие.ДоляБезопаснойПамяти, 70));
	М = Спец.Масштабирование;
	К.Вставить("Масштабировать", М.Включено = Истина);
	К.Вставить("СеансовНаСервер", Значение(М.СеансовНаСервер, 20));
	К.Вставить("МаксимумРабочих", Значение(М.Максимум, 4));
	Л = Спец.Лицензии;
	К.Вставить("РежимЛицензий", Значение(Л.Режим, "community"));
	К.Вставить("ЛицензийСеансов", Значение(Л.Сеансов, ?(Значение(Л.Режим, "community") = "community", 3, 0)));
	К.Вставить("ЛицензийСерверов", Значение(Л.Серверов, 0));
	С = Спец.СУБД;
	К.Вставить("ЭкземпляровСУБД", Значение(С.Экземпляров, 1));
	К.Вставить("ОбъёмСУБД", Значение(С.Объём, "10Gi"));
	К.Вставить("ПроцессорСУБД", Значение(С.Процессор, "500m"));
	К.Вставить("ПамятьСУБД", Значение(С.Память, "2Gi"));
	К.Вставить("КлассХранения", Значение(Спец.КлассХранения, ""));
	Возврат К;

КонецФункции

Процедура ПровестиСУБД(Объект, К)

	С = Новый ОбъектКластера("Cluster", К.Имя + "-pg");
	С.ВерсияAPI = "postgresql.cnpg.io/v1";
	С.Метаданные.Подразделение = К.Подразделение;
	Спец = С.Спецификация;
	Спец.instances = К.ЭкземпляровСУБД;
	Если ЗначениеЗаполнено(К.ОбразСУБД) Тогда
		Спец.imageName = К.ОбразСУБД;
	КонецЕсли;
	Спец.enableSuperuserAccess = Истина;
	Спец.storage.size = К.ОбъёмСУБД;
	Если ЗначениеЗаполнено(К.КлассХранения) Тогда
		Спец.storage.КлассХранения = К.КлассХранения;
	КонецЕсли;
	Ресурсы(Спец, К.ПроцессорСУБД, К.ПамятьСУБД);
	// Рекомендации 1С для PostgreSQL: блокировок много, временных таблиц много.
	Параметры = Спец.postgresql.parameters;
	Параметры.Вставить("max_locks_per_transaction", "256");
	Параметры.Вставить("standard_conforming_strings", "off");
	Параметры.Вставить("escape_string_warning", "off");
	Кластер.Провести(С, Объект);

КонецПроцедуры

Процедура ПровестиУслуги(Объект, К)

	// безголовая: даёт подам имена, по которым кластер 1С находит серверы
	Серверы = Новый Услуга(К.Имя + "-servery", К.Подразделение);
	Серверы.Спецификация.КластерныйАдрес = "None";
	Серверы.Спецификация.publishNotReadyAddresses = Истина;
	Серверы.Спецификация.Отбор.Вставить("app.kubernetes.io/part-of", К.Имя);
	Порт(Серверы, "agent", 1540);
	Порт(Серверы, "manager", 1541);
	Кластер.Провести(Серверы, Объект);

	Админ = Новый Услуга(К.Имя + "-ras", К.Подразделение);
	Админ.Спецификация.Отбор.Вставить("statefulset.kubernetes.io/pod-name", К.Имя + "-central-0");
	Порт(Админ, "ras", 1545);
	Порт(Админ, "agent", 1540);
	Кластер.Провести(Админ, Объект);

	Выгрузки = Новый ЗаявкаНаТом(К.Имя + "-vygruzki", К.Подразделение);
	Выгрузки.Спецификация.РежимыДоступа.Добавить("ReadWriteOnce");
	Выгрузки.Спецификация.Ресурсы.Запросы.Объём = К.ОбъёмСУБД;
	Если ЗначениеЗаполнено(К.КлассХранения) Тогда
		Выгрузки.Спецификация.КлассХранения = К.КлассХранения;
	КонецЕсли;
	Кластер.Провести(Выгрузки, Объект);

КонецПроцедуры

Процедура ПровестиЦентральный(Объект, К)

	Н = НаборСерверов(К, "central", 1, К.ПроцессорЦентрального, К.ПамятьЦентрального);
	Под = Н.Спецификация.Шаблон.Спецификация;
	Агент = Под.Контейнеры[0];
	Переменная(Агент, "ZAGLUSHKA_LICENZIJ", Формат(К.ЛицензийСеансов, "ЧГ=0; ЧН=0"));
	Ras = Под.Контейнеры.Добавить();
	Ras.Имя = "ras";
	Ras.Образ = К.Образ;
	Команда(Ras, К.Путь + "/ras cluster --port=1545 localhost:1540");
	Ресурсы(Ras, "50m", "128Mi");
	П = Ras.Порты.Добавить();
	П.ПортКонтейнера = 1545;
	Кластер.Провести(Н, Объект);

КонецПроцедуры

Процедура ПровестиРабочие(Объект, К, Количество)

	Н = НаборСерверов(К, "rabochij", Количество, К.Процессор, К.Память);
	Кластер.Провести(Н, Объект);

КонецПроцедуры

// Набор подов с агентом сервера 1С: у каждого своё имя хоста, свой реестр
// и, для настоящей платформы, установка из архива поставки перед запуском.
Функция НаборСерверов(К, Роль, Количество, Процессор, Память)

	Имя = К.Имя + "-" + Роль;
	Н = Новый НаборСоСостоянием(Имя, К.Подразделение);
	Н.Метаданные.Метки.Вставить("app.kubernetes.io/component", Роль);
	Спец = Н.Спецификация;
	Спец.Реплики = Количество;
	Спец.serviceName = К.Имя + "-servery";
	Спец.podManagementPolicy = "Parallel";
	Спец.Отбор.ПоМеткам.Вставить("app.kubernetes.io/instance", Имя);
	Шаблон = Спец.Шаблон;
	Шаблон.Метаданные.Метки.Вставить("app.kubernetes.io/instance", Имя);
	Шаблон.Метаданные.Метки.Вставить("app.kubernetes.io/part-of", К.Имя);
	Под = Шаблон.Спецификация;
	Под.subdomain = К.Имя + "-servery";
	Под.КонтекстБезопасности.ГруппаФайлов = 999;

	Агент = Под.Контейнеры.Добавить();
	Агент.Имя = "ragent";
	Агент.Образ = К.Образ;
	П = Агент.Окружение.Добавить();
	П.Имя = "POD_NAME";
	П.ЗначениеИз.fieldRef.fieldPath = "metadata.name";
	Переменная(Агент, "ONEC_HOSTNAME", "$(POD_NAME)." + К.Имя + "-servery");
	Команда(Агент, К.Путь + "/ragent -d /home/usr1cv8/.1cv8/1C/1cv8 -port 1540 -regport 1541 -range 1560:1591 -seclev 0");
	Ресурсы(Агент, Процессор, Память);
	Для Каждого Номер Из СтрРазделить("1540,1541,1560", ",") Цикл
		П = Агент.Порты.Добавить();
		П.ПортКонтейнера = Число(Номер);
	КонецЦикла;
	Агент.ПробаГотовности.tcpSocket.Порт = 1540;
	Агент.ПробаГотовности.ПериодСекунд = 5;
	Подключить(Агент, "reestr", "/home/usr1cv8/.1cv8");

	Если НЕ К.Заглушка Тогда
		УстановкаПлатформы(Под, К);
		Подключить(Агент, "platforma", "/opt/1cv8");
	КонецЕсли;
	ШаблонТома(Спец, "reestr", "1Gi", К.КлассХранения);
	Возврат Н;

КонецФункции

// Установка платформы из архива поставки, при каждом запуске пода —
// как с диска ИТС. Образ — основа с библиотеками, без программ фирмы «1С».
Процедура УстановкаПлатформы(Под, К)

	Том = Под.Тома.Добавить();
	Том.Имя = "platforma";
	Том.ПустойКаталог.sizeLimit = "3Gi";
	Установка = Под.НачальныеКонтейнеры.Добавить();
	Установка.Имя = "ustanovka";
	Установка.Образ = К.Образ;
	Установка.КонтекстБезопасности.ПользовательЗапуска = 0;
	Команда(Установка, СтрШаблон("set -e
		|cd /tmp && wget -q -O platforma.tar.gz '%1' && tar -xzf platforma.tar.gz
		|./setup-full-*.run --mode unattended --enable-components server,ws,server_admin
		|chown -R 999:999 /opt/1cv8", К.Архив));
	Ресурсы(Установка, "500m", "1Gi");
	Подключить(Установка, "platforma", "/opt/1cv8");

КонецПроцедуры

#КонецОбласти

#Область СерверыИЛицензии

Функция ЖелаемоРабочих(К, Сеансов)

	Если НЕ К.Масштабировать Тогда
		Возврат К.Рабочих;
	КонецЕсли;
	// центральный сервер тоже принимает сеансы
	Нужно = Цел((Сеансов + К.СеансовНаСервер - 1) / К.СеансовНаСервер) - 1;
	Возврат Макс(К.Рабочих, Мин(К.МаксимумРабочих, Нужно));

КонецФункции

Функция ОграничитьЛицензиями(Объект, К, Желаемо)

	Если К.РежимЛицензий = "software" И К.ЛицензийСерверов > 0 И Желаемо + 1 > К.ЛицензийСерверов Тогда
		Журнал.Предупреждение(СтрШаблон("Кластер «%1»: нет свободной лицензии на сервер — нужно %2, куплено %3. Рабочих будет %4.",
			К.Имя, Желаемо + 1, К.ЛицензийСерверов, К.ЛицензийСерверов - 1));
		Кластер.ЗаписатьСобытие(Объект, "Предупреждение", "НетЛицензии",
			СтрШаблон("Нет свободной лицензии на сервер: серверов нужно %1, лицензий %2", Желаемо + 1, К.ЛицензийСерверов));
		Возврат Макс(0, К.ЛицензийСерверов - 1);
	КонецЕсли;
	Возврат Желаемо;

КонецФункции

Функция ХостРабочего(К, Номер)

	Возврат СтрШаблон("%1-rabochij-%2.%1-servery", К.Имя, Формат(Номер, "ЧГ=0; ЧН=0"));

КонецФункции

Функция НомерРабочего(К, Хост)

	Префикс = К.Имя + "-rabochij-";
	Если НЕ СтрНачинаетсяС(Хост, Префикс) Тогда
		Возврат -1;
	КонецЕсли;
	Хвост = СтрРазделить(Сред(Хост, СтрДлина(Префикс) + 1), ".")[0];
	Попытка
		Возврат Число(Хвост);
	Исключение
		Возврат -1;
	КонецПопытки;

КонецФункции

// Регистрирует в кластере рабочие серверы, поды которых готовы.
Процедура ПринятьНовых(К, КластерИД, Серверы, Желаемо)

	Зарегистрированы = Новый Соответствие;
	Для Каждого С Из Серверы Цикл
		Зарегистрированы.Вставить(С.Получить("agent-host"), Истина);
	КонецЦикла;
	Для Номер = 0 По Желаемо - 1 Цикл
		Хост = ХостРабочего(К, Номер);
		Если Зарегистрированы.Получить(Хост) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПодГотов(СтрШаблон("%1-rabochij-%2", К.Имя, Формат(Номер, "ЧГ=0; ЧН=0")), К.Подразделение) Тогда
			Продолжить;
		КонецЕсли;
		RAC(К, СтрШаблон("server insert --cluster=%1 --agent-host=%2 --agent-port=1540 --port-range=1560:1591 --name='Рабочий %3' --using=normal",
			КластерИД, Хост, Номер + 1));
		Журнал.Информация(СтрШаблон("Кластер «%1»: принят на работу сервер %2", К.Имя, Хост));
	КонецЦикла;

КонецПроцедуры

// Увольняет рабочие серверы сверх желаемого: сначала запрещает им новые
// сеансы, потом ждёт, пока доработают текущие, потом исключает из кластера.
// Возвращает, сколько серверов ещё дорабатывают.
Функция УволитьЛишних(К, КластерИД, Серверы, Процессы, Сеансы, Желаемо)

	Дорабатывают = 0;
	Для Каждого С Из Серверы Цикл
		Номер = НомерРабочего(К, С.Получить("agent-host"));
		Если Номер < Желаемо Тогда
			Продолжить;
		КонецЕсли;
		ИД = С.Получить("server");
		Если НЕ ЕстьПравилоНикогда(К, КластерИД, ИД) Тогда
			RAC(К, СтрШаблон("rule insert --cluster=%1 --server=%2 --position=0 --rule-type=never", КластерИД, ИД));
			RAC(К, СтрШаблон("rule apply --cluster=%1 --full", КластерИД));
			Журнал.Информация(СтрШаблон("Кластер «%1»: сервер %2 больше не принимает сеансы — дорабатывает", К.Имя, С.Получить("agent-host")));
		КонецЕсли;
		Осталось = СеансовНаСервере(С, Процессы, Сеансы);
		Если Осталось > 0 Тогда
			Дорабатывают = Дорабатывают + 1;
			Продолжить;
		КонецЕсли;
		RAC(К, СтрШаблон("server remove --cluster=%1 --server=%2", КластерИД, ИД));
		Журнал.Информация(СтрШаблон("Кластер «%1»: сервер %2 уволен по истечении срочного трудового договора", К.Имя, С.Получить("agent-host")));
	КонецЦикла;
	Возврат Дорабатывают;

КонецФункции

Функция ЕстьПравилоНикогда(К, КластерИД, Сервер)

	Для Каждого П Из РазобратьRAC(RAC(К, СтрШаблон("rule list --cluster=%1 --server=%2", КластерИД, Сервер))) Цикл
		Если П.Получить("rule-type") = "never" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция СеансовНаСервере(Сервер, Процессы, Сеансы)

	ПроцессыСервера = Новый Соответствие;
	Для Каждого П Из Процессы Цикл
		Если П.Получить("host") = Сервер.Получить("agent-host") Тогда
			ПроцессыСервера.Вставить(П.Получить("process"), Истина);
		КонецЕсли;
	КонецЦикла;
	Количество = 0;
	Для Каждого С Из Сеансы Цикл
		Если ПроцессыСервера.Получить(С.Получить("process")) = Истина Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

// Вертикальное масштабирование: лимиты памяти рабочих процессов идут за
// памятью пода — повышение оклада по служебной записке.
Процедура ВыставитьЛимитыПамяти(К, КластерИД, Серверы)

	Для Каждого С Из Серверы Цикл
		Центральный = (С.Получить("using") = "main");
		Память = РазобратьКоличество(?(Центральный, К.ПамятьЦентрального, К.Память));
		Безопасно = Цел(Память * К.ДоляПамяти / 100);
		Критично = Цел(Память * 95 / 100);
		Если Число(С.Получить("safe-working-processes-memory-limit")) = Безопасно
			И Число(С.Получить("critical-total-memory")) = Критично
			И Число(С.Получить("infobases-limit")) = К.ИБНаПроцесс
			И Число(С.Получить("connections-limit")) = К.СоединенийНаПроцесс Тогда
			Продолжить;
		КонецЕсли;
		RAC(К, СтрШаблон("server update --cluster=%1 --server=%2 --safe-working-processes-memory-limit=%3 --critical-total-memory=%4 --infobases-limit=%5 --connections-limit=%6",
			КластерИД, С.Получить("server"), Формат(Безопасно, "ЧГ=0"), Формат(Критично, "ЧГ=0"),
			Формат(К.ИБНаПроцесс, "ЧГ=0"), Формат(К.СоединенийНаПроцесс, "ЧГ=0")));
		Журнал.Информация(СтрШаблон("Кластер «%1»: серверу %2 выставлен безопасный расход памяти %3 МБ",
			К.Имя, С.Получить("agent-host"), Формат(Цел(Безопасно / 1048576), "ЧГ=0")));
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСостояние(Объект, К, Серверы, Процессы, Сеансы, Желаемо)

	Состояние = Объект.Состояние;
	Описание = Новый Массив;
	Для Каждого С Из Серверы Цикл
		Память = 0;
		Для Каждого П Из Процессы Цикл
			Если П.Получить("host") = С.Получить("agent-host") Тогда
				Память = Память + Число(П.Получить("memory-size"));
			КонецЕсли;
		КонецЦикла;
		Описание.Добавить(Новый Структура("Имя, Хост, Роль, Сеансов, ПамятьКБ",
			С.Получить("name"), С.Получить("agent-host"),
			?(С.Получить("using") = "main", "центральный", "рабочий"),
			СеансовНаСервере(С, Процессы, Сеансы), Память));
	КонецЦикла;
	Состояние.Серверы = Описание;
	Состояние.Серверов = СтрШаблон("%1/%2", Серверы.Количество(), Желаемо + 1);
	Состояние.Сеансов = Сеансы.Количество();
	Если Серверы.Количество() = Желаемо + 1 Тогда
		Состояние.Фаза = "Работает";
		Состояние.Сообщение = СтрШаблон("Кластер работает: серверов %1, сеансов %2.", Серверы.Количество(), Сеансы.Количество());
	Иначе
		Состояние.Фаза = "Перестройка";
		Состояние.Сообщение = СтрШаблон("Серверов %1, а нужно %2: кого-то принимаем, кто-то дорабатывает.", Серверы.Количество(), Желаемо + 1);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ИнформационнаяБаза

&Обработка(Вид = "ИнформационнаяБаза", Владеет = "Задание", Наблюдает = "КластерСерверов")
Процедура ИнформационнаяБазаОбработкаПроведения(Объект, Отказ) Экспорт

	Состояние = Объект.Состояние;
	ИмяБазы = ИмяAPI(Объект.Метаданные.Имя);
	К = КластерБазы(Объект, Отказ);
	Если К = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Зарегистрирована = НайтиБазу(К, ИмяБазы) <> Неопределено;
	Состояние.Зарегистрирована = Зарегистрирована;
	Если Зарегистрирована Тогда
		Состояние.Фаза = "Работает";
		Если НЕ ЗначениеЗаполнено(Состояние.Конфигурация) Тогда
			Состояние.Конфигурация = КонфигурацияШаблона(Объект.Спецификация.Шаблон);
		КонецЕсли;
		Состояние.Сообщение = СтрШаблон("База «%1» зарегистрирована в кластере «%2».", ИмяБазы, К.Имя);
		ПовторитьЧерез(300);
		Возврат;
	КонецЕсли;

	ИмяЗадания = ИмяБазы + "-sozdanie";
	Задание = Кластер.Получить("Задание", ИмяЗадания, К.Подразделение);
	Если Задание = Неопределено Тогда
		Скрипт = ПолучениеФайла(Объект.Спецификация.Шаблон, "/tmp/shablon") + "
			|" + СтрШаблон("%1/ibcmd infobase create %2 --create-database --locale=ru %3
			|%1/rac %4-ras:1545 infobase create --cluster=%5 --name=%6 %7 --locale=ru --license-distribution=allow",
			К.Путь, ПараметрыБазыДанных(К, ИмяБазы),
			?(ЗначениеЗаполнено(Объект.Спецификация.Шаблон.Справочник) ИЛИ ЗначениеЗаполнено(Объект.Спецификация.Шаблон.URL),
				?(СтрЗаканчиваетсяНа(НРег(ИмяФайла(Объект.Спецификация.Шаблон)), ".dt"), "--restore=/tmp/shablon", "--load=/tmp/shablon --apply --force"), ""),
			К.Имя, К.Кластер, ИмяБазы, ПараметрыБазыДанных(К, ИмяБазы));
		Кластер.Провести(ЗаданиеСервера(К, ИмяЗадания, Скрипт, Объект.Спецификация.Шаблон), Объект);
		Состояние.Фаза = "Создаётся";
		Состояние.Сообщение = "Создаю базу данных и загружаю конфигурацию.";
		ПовторитьЧерез(15);
		Возврат;
	КонецЕсли;
	Если ЗаданиеУпало(Задание) Тогда
		Отказ = Истина;
		Состояние.Фаза = "Ошибка";
		Состояние.Сообщение = СтрШаблон("Задание «%1» завершилось ошибкой: журнал — 1сctl журнал на его поде. Чтобы попробовать снова, удалите задание.", ИмяЗадания);
		Сообщить(Состояние.Сообщение);
		Возврат;
	КонецЕсли;
	Состояние.Фаза = "Создаётся";
	Состояние.Сообщение = "Создаю базу данных и загружаю конфигурацию.";
	ПовторитьЧерез(15);

КонецПроцедуры

&ПередУдалением(Вид = "ИнформационнаяБаза")
Процедура ИнформационнаяБазаПередУдалением(Объект, Отказ) Экспорт

	К = КластерБазы(Объект, Отказ);
	Если К = Неопределено Тогда
		Отказ = Ложь; // кластера уже нет — снимать с учёта негде
		Возврат;
	КонецЕсли;
	ИмяБазы = ИмяAPI(Объект.Метаданные.Имя);
	База = НайтиБазу(К, ИмяБазы);
	Если База = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УдалитьДанные = Объект.Спецификация.УдалятьБазуДанных = Истина;
	RAC(К, СтрШаблон("infobase drop --cluster=%1 --infobase=%2%3", К.Кластер, База.Получить("infobase"),
		?(УдалитьДанные, " --drop-database", "")));
	Журнал.Информация(СтрШаблон("База «%1» снята с учёта в кластере «%2»%3", ИмяБазы, К.Имя,
		?(УдалитьДанные, " и удалена из СУБД", "; база данных в СУБД оставлена — списывать по акту")));

КонецПроцедуры

// Возвращает параметры кластера базы, когда он работает; иначе Неопределено.
Функция КластерБазы(Объект, Отказ)

	Состояние = Объект.Состояние;
	ИмяКластера = Объект.Спецификация.КластерСерверов;
	Подразделение = Объект.Метаданные.Подразделение;
	КС = Кластер.Получить("КластерСерверов", ИмяКластера, Подразделение);
	Если КС = Неопределено ИЛИ НЕ ЗначениеЗаполнено(КС.Состояние.Кластер) Тогда
		Состояние.Фаза = "ОжидаетКластер";
		Состояние.Сообщение = СтрШаблон("Кластер серверов «%1» ещё не работает.", ИмяКластера);
		ПовторитьЧерез(30);
		Возврат Неопределено;
	КонецЕсли;
	К = ПараметрыКластера(КС);
	Поставка = Кластер.Получить("Поставка", К.Поставка);
	Если Поставка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	К.Вставить("Кластер", КС.Состояние.Кластер);
	К.Вставить("Образ", ОбразСервера(Поставка));
	К.Вставить("Путь", ПутьПлатформы(Поставка));
	К.Вставить("Заглушка", Поставка.Спецификация.Заглушка = Истина);
	К.Вставить("Архив", Значение(Поставка.Спецификация.Архив, ""));
	Возврат К;

КонецФункции

Функция НайтиБазу(К, ИмяБазы)

	Для Каждого Б Из РазобратьRAC(RAC(К, "infobase summary list --cluster=" + К.Кластер)) Цикл
		Если Б.Получить("name") = ИмяБазы Тогда
			Возврат Б;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Параметры базы данных для ibcmd и rac; пароль суперпользователя СУБД
// задание берёт из секрета CloudNativePG в переменной PGPASSWORD.
Функция ПараметрыБазыДанных(К, ИмяБазы)

	Возврат СтрШаблон("--dbms=PostgreSQL --db-server=%1-pg-rw --db-name=%2 --db-user=postgres --db-pwd=""$PGPASSWORD""",
		К.Имя, ИмяБазы);

КонецФункции

// Задание с образом сервера: ibcmd, rac, выгрузки на томе кластера.
Функция ЗаданиеСервера(К, Имя, Скрипт, Файл)

	З = Новый Задание(Имя, К.Подразделение);
	З.Спецификация.ЛимитПовторов = 2;
	З.Спецификация.ttlSecondsAfterFinished = 86400;
	Под = З.Спецификация.Шаблон.Спецификация;
	Под.ПолитикаПерезапуска = "Never";
	Под.КонтекстБезопасности.ГруппаФайлов = 999;
	С = Под.Контейнеры.Добавить();
	С.Имя = "ibcmd";
	С.Образ = К.Образ;
	Команда(С, "set -e" + Символы.ПС + Скрипт);
	ПеременнаяИзСекрета(С, "PGPASSWORD", К.Имя + "-pg-superuser", "password");
	Ресурсы(С, "250m", "512Mi");
	Подключить(С, "vygruzki", "/vygruzki");
	Том = Под.Тома.Добавить();
	Том.Имя = "vygruzki";
	Том.ЗаявкаНаТом.ИмяЗаявки = К.Имя + "-vygruzki";
	Если Файл <> Неопределено И ЗначениеЗаполнено(Файл.Справочник) Тогда
		Подключить(С, "fajl", "/fajl");
		Том = Под.Тома.Добавить();
		Том.Имя = "fajl";
		Том.Справочник.Имя = Файл.Справочник;
	КонецЕсли;
	Если НЕ К.Заглушка Тогда
		УстановкаПлатформы(Под, К);
		Подключить(С, "platforma", "/opt/1cv8");
	КонецЕсли;
	Возврат З;

КонецФункции

// Команды, которые кладут файл (из справочника или по адресу) в Куда.
Функция ПолучениеФайла(Файл, Куда)

	Если Файл = Неопределено Тогда
		Возврат "true";
	ИначеЕсли ЗначениеЗаполнено(Файл.Справочник) Тогда
		Возврат СтрШаблон("cp '/fajl/%1' %2", Файл.Ключ, Куда);
	ИначеЕсли ЗначениеЗаполнено(Файл.URL) Тогда
		Возврат СтрШаблон("wget -q -O %1 '%2'", Куда, Файл.URL);
	КонецЕсли;
	Возврат "true";

КонецФункции

Функция ИмяФайла(Файл)

	Если ЗначениеЗаполнено(Файл.Справочник) Тогда
		Возврат Файл.Ключ;
	КонецЕсли;
	Возврат Значение(Файл.URL, "");

КонецФункции

// Имя и версия конфигурации из имени файла шаблона: buhgalteriya-3.0.202.14.cf.
Функция КонфигурацияШаблона(Файл)

	Имя = ИмяФайла(Файл);
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат "пустая";
	КонецЕсли;
	Части = СтрРазделить(Имя, "/");
	Возврат Части[Части.ВГраница()];

КонецФункции

Функция ЗаданиеУпало(Задание)

	Возврат ЗначениеЗаполнено(Задание.Состояние.failed) И Задание.Состояние.failed > 0
		И НЕ ЗначениеЗаполнено(Задание.Состояние.active);

КонецФункции

Функция ЗаданиеВыполнено(Задание)

	Возврат ЗначениеЗаполнено(Задание.Состояние.succeeded) И Задание.Состояние.succeeded > 0;

КонецФункции

#КонецОбласти

#Область Публикация

&Обработка(Вид = "Публикация", Владеет = "Развёртывание, Услуга, Проходная", Наблюдает = "ИнформационнаяБаза")
Процедура ПубликацияОбработкаПроведения(Объект, Отказ) Экспорт

	Состояние = Объект.Состояние;
	Подразделение = Объект.Метаданные.Подразделение;
	Имя = ИмяAPI(Объект.Метаданные.Имя);
	ИмяБазы = ИмяAPI(Объект.Спецификация.ИнформационнаяБаза);
	База = Кластер.Получить("ИнформационнаяБаза", Объект.Спецификация.ИнформационнаяБаза, Подразделение);
	Если База = Неопределено ИЛИ База.Состояние.Зарегистрирована <> Истина Тогда
		Состояние.Фаза = "ОжидаетБазу";
		Состояние.Сообщение = СтрШаблон("База «%1» ещё не зарегистрирована.", Объект.Спецификация.ИнформационнаяБаза);
		ПовторитьЧерез(30);
		Возврат;
	КонецЕсли;
	К = КластерБазы(База, Отказ);
	Если К = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Адрес = Значение(Объект.Спецификация.Адрес, "/" + ИмяБазы);

	Р = Новый Развёртывание(Имя, Подразделение);
	Р.Спецификация.Реплики = Значение(Объект.Спецификация.Реплики, 1);
	Р.Спецификация.Отбор.ПоМеткам.Вставить("app.kubernetes.io/instance", Имя);
	Р.Спецификация.Шаблон.Метаданные.Метки.Вставить("app.kubernetes.io/instance", Имя);
	Под = Р.Спецификация.Шаблон.Спецификация;
	С = Под.Контейнеры.Добавить();
	С.Имя = "veb";
	С.Образ = К.Образ;
	Если К.Заглушка Тогда
		Команда(С, СтрШаблон("exec 1c-zaglushka publikaciya --port 8080 --base %1 --agent %2-ras:1540 --infobase %3",
			Адрес, К.Имя, ИмяБазы));
	Иначе
		// Apache с модулем веб-расширения платформы и default.vrd от webinst
		Команда(С, СтрШаблон("%1/webinst -publish -apache24 -wsdir %2 -dir /var/www%3 -connstr 'Srvr=%4-central-0.%4-servery;Ref=%5;' -confpath /etc/apache2/apache2.conf
			|exec apache2ctl -D FOREGROUND", К.Путь, Сред(Адрес, 2), Адрес, К.Имя, ИмяБазы));
		УстановкаПлатформы(Под, К);
		Подключить(С, "platforma", "/opt/1cv8");
	КонецЕсли;
	П = С.Порты.Добавить();
	П.ПортКонтейнера = 8080;
	С.ПробаГотовности.HTTPЗапрос.Путь = "/healthz";
	С.ПробаГотовности.HTTPЗапрос.Порт = 8080;
	Ресурсы(С, "100m", "256Mi");
	Кластер.Провести(Р, Объект);

	У = Новый Услуга(Имя, Подразделение);
	У.Спецификация.Отбор.Вставить("app.kubernetes.io/instance", Имя);
	Порт(У, "http", 8080);
	Кластер.Провести(У, Объект);

	Если ЗначениеЗаполнено(Объект.Спецификация.Домен) Тогда
		Пр = Новый Проходная(Имя, Подразделение);
		Пр.Спецификация.КлассПроходной = Значение(Объект.Спецификация.КлассПроходной, "nginx");
		Правило = Пр.Спецификация.Правила.Добавить();
		Правило.Хост = Объект.Спецификация.Домен;
		Путь = Правило.HTTP.Пути.Добавить();
		Путь.Путь = Адрес;
		Путь.ТипПути = "Prefix";
		Путь.Получатель.Услуга.Имя = Имя;
		Путь.Получатель.Услуга.Порт.Номер = 8080;
		Кластер.Провести(Пр, Объект);
		Состояние.Адрес = "http://" + Объект.Спецификация.Домен + Адрес + "/";
	Иначе
		Состояние.Адрес = СтрШаблон("http://%1.%2.svc:8080%3/", Имя, Подразделение, Адрес);
	КонецЕсли;
	Состояние.Фаза = "Опубликована";
	Состояние.Сообщение = "Веб-клиент: " + Состояние.Адрес;

КонецПроцедуры

#КонецОбласти

#Область ОбновлениеКонфигурации

// Обновление: окно работ → блокировка сеансов с кодом разрешения →
// «Выйдите из базы!» → завершение сеансов → выгрузка → загрузка и
// применение конфигурации → снятие блокировки.
&Обработка(Вид = "ОбновлениеКонфигурации", Владеет = "Задание")
Процедура ОбновлениеОбработкаПроведения(Объект, Отказ) Экспорт

	Состояние = Объект.Состояние;
	Фаза = Значение(Состояние.Фаза, "ОжидаетОкна");
	Если Фаза = "Выполнено" ИЛИ Фаза = "Ошибка" Тогда
		Возврат;
	КонецЕсли;
	Подразделение = Объект.Метаданные.Подразделение;
	Имя = ИмяAPI(Объект.Метаданные.Имя);
	База = Кластер.Получить("ИнформационнаяБаза", Объект.Спецификация.ИнформационнаяБаза, Подразделение);
	Если База = Неопределено ИЛИ База.Состояние.Зарегистрирована <> Истина Тогда
		Состояние.Фаза = "ОжидаетОкна";
		Состояние.Сообщение = "База ещё не зарегистрирована.";
		ПовторитьЧерез(60);
		Возврат;
	КонецЕсли;
	К = КластерБазы(База, Отказ);
	Если К = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяБазы = ИмяAPI(База.Метаданные.Имя);
	Описание = НайтиБазу(К, ИмяБазы);
	Код = "obnovlenie-" + Имя;

	Если Фаза = "ОжидаетОкна" Тогда
		Если НЕ ВОкнеРабот(Объект.Спецификация) Тогда
			Состояние.Сообщение = СтрШаблон("Жду окна работ %1: днём бухгалтерия работает.", Объект.Спецификация.ОкноРабот);
			ПовторитьЧерез(300);
			Возврат;
		КонецЕсли;
		Состояние.Начато = XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z";
		RAC(К, СтрШаблон("infobase update --cluster=%1 --infobase=%2 --sessions-deny=on --scheduled-jobs-deny=on --permission-code=%3 --denied-message='Выполняется обновление конфигурации. Выйдите из базы!'",
			К.Кластер, Описание.Получить("infobase"), Код));
		Состояние.Фаза = "ЗавершениеСеансов";
		Состояние.Сообщение = "Начало сеансов запрещено. Пользователей попросили выйти из базы.";
		ПовторитьЧерез(Макс(5, Значение(Объект.Спецификация.ПредупредитьЗаМинут, 0) * 60));
		Возврат;
	КонецЕсли;

	Если Фаза = "ЗавершениеСеансов" Тогда
		Завершено = 0;
		Для Каждого С Из РазобратьRAC(RAC(К, СтрШаблон("session list --cluster=%1 --infobase=%2", К.Кластер, Описание.Получить("infobase")))) Цикл
			RAC(К, СтрШаблон("session terminate --cluster=%1 --session=%2 --error-message='Сеанс завершён администратором: обновление конфигурации'",
				К.Кластер, С.Получить("session")));
			Завершено = Завершено + 1;
		КонецЦикла;
		Журнал.Информация(СтрШаблон("База «%1»: перед обновлением завершено сеансов: %2", ИмяБазы, Завершено));
		Состояние.Фаза = "Выгрузка";
	КонецЕсли;

	Если Состояние.Фаза = "Выгрузка" Тогда
		Файл = СтрШаблон("/vygruzki/%1-pered-%2.dt", ИмяБазы, Имя);
		Готово = ВыполнитьЗадание(К, Имя + "-vygruzka", Объект,
			СтрШаблон("%1/ibcmd infobase dump %2 %3", К.Путь, ПараметрыБазыДанных(К, ИмяБазы), Файл), Неопределено);
		Если Готово = Неопределено Тогда
			Состояние.Сообщение = "Выгружаю базу перед обновлением. Выгрузку .dt сделали? Делаю.";
			ПовторитьЧерез(15);
			Возврат;
		ИначеЕсли НЕ Готово Тогда
			ОшибкаОбновления(Объект, К, Описание, "Выгрузка перед обновлением не удалась — обновлять без неё не буду.");
			Возврат;
		КонецЕсли;
		Состояние.Выгрузка = Файл;
		Состояние.Фаза = "Обновление";
	КонецЕсли;

	Если Состояние.Фаза = "Обновление" Тогда
		Файл = Объект.Спецификация.Файл;
		Расширение = Объект.Спецификация.Расширение;
		Скрипт = ПолучениеФайла(Файл, "/tmp/obnovlenie") + Символы.ПС;
		Если ЗначениеЗаполнено(Расширение) Тогда
			Скрипт = Скрипт + СтрШаблон("%1/ibcmd infobase config load %2 --extension=%3 /tmp/obnovlenie", К.Путь, ПараметрыБазыДанных(К, ИмяБазы), Расширение);
		Иначе
			Скрипт = Скрипт + СтрШаблон("%1/ibcmd infobase config load %2 /tmp/obnovlenie
				|%1/ibcmd infobase config apply %2 --force", К.Путь, ПараметрыБазыДанных(К, ИмяБазы));
		КонецЕсли;
		Готово = ВыполнитьЗадание(К, Имя + "-zagruzka", Объект, Скрипт, Файл);
		Если Готово = Неопределено Тогда
			Состояние.Сообщение = "Обновляю конфигурацию базы данных. Не выключайте компьютер.";
			ПовторитьЧерез(15);
			Возврат;
		ИначеЕсли НЕ Готово Тогда
			ОшибкаОбновления(Объект, К, Описание, "Конфигурация не обновилась. Выгрузка до обновления: " + Состояние.Выгрузка);
			Возврат;
		КонецЕсли;
		СнятьБлокировку(К, Описание);
		Если НЕ ЗначениеЗаполнено(Расширение) Тогда
			База.Состояние.Конфигурация = КонфигурацияШаблона(Файл);
			Кластер.ЗаписатьСостояние(База);
		КонецЕсли;
		Состояние.Фаза = "Выполнено";
		Состояние.Завершено = XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z";
		Состояние.Сообщение = СтрШаблон("Конфигурация обновлена: %1. Выгрузка до обновления: %2. Можно входить.", КонфигурацияШаблона(Файл), Состояние.Выгрузка);
		Кластер.ЗаписатьСобытие(Объект, "Обычное", "Обновлено", Состояние.Сообщение);
	КонецЕсли;

КонецПроцедуры

Процедура ОшибкаОбновления(Объект, К, Описание, Текст)

	СнятьБлокировку(К, Описание);
	Объект.Состояние.Фаза = "Ошибка";
	Объект.Состояние.Сообщение = Текст + " Блокировка сеансов снята.";
	Кластер.ЗаписатьСобытие(Объект, "Предупреждение", "НеОбновлено", Объект.Состояние.Сообщение);

КонецПроцедуры

Процедура СнятьБлокировку(К, Описание)

	RAC(К, СтрШаблон("infobase update --cluster=%1 --infobase=%2 --sessions-deny=off --scheduled-jobs-deny=off --denied-message='' --permission-code=''",
		К.Кластер, Описание.Получить("infobase")));

КонецПроцедуры

// Окно «22-6»: с 22 до 6 по местному времени.
Функция ВОкнеРабот(Спецификация)

	Окно = Спецификация.ОкноРабот;
	Если НЕ ЗначениеЗаполнено(Окно) Тогда
		Возврат Истина;
	КонецЕсли;
	Часы = СтрРазделить(Окно, "-");
	Если Часы.Количество() <> 2 Тогда
		Возврат Истина;
	КонецЕсли;
	Начало = Число(Часы[0]);
	Конец = Число(Часы[1]);
	Сейчас = Час(МестноеВремя(ТекущаяУниверсальнаяДата(), Значение(Спецификация.ЧасовойПояс, "Europe/Moscow")));
	Если Начало <= Конец Тогда
		Возврат Сейчас >= Начало И Сейчас < Конец;
	КонецЕсли;
	Возврат Сейчас >= Начало ИЛИ Сейчас < Конец;

КонецФункции

// Ставит задание, если его нет. Истина — выполнено, Ложь — упало,
// Неопределено — ещё идёт.
Функция ВыполнитьЗадание(К, Имя, Владелец, Скрипт, Файл)

	Задание = Кластер.Получить("Задание", Имя, К.Подразделение);
	Если Задание = Неопределено Тогда
		Кластер.Провести(ЗаданиеСервера(К, Имя, Скрипт, Файл), Владелец);
		Возврат Неопределено;
	КонецЕсли;
	Если ЗаданиеВыполнено(Задание) Тогда
		Возврат Истина;
	ИначеЕсли ЗаданиеУпало(Задание) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область Выгрузка

&Обработка(Вид = "Выгрузка", Владеет = "Задание, РегламентноеЗадание")
Процедура ВыгрузкаОбработкаПроведения(Объект, Отказ) Экспорт

	Состояние = Объект.Состояние;
	Подразделение = Объект.Метаданные.Подразделение;
	Имя = ИмяAPI(Объект.Метаданные.Имя);
	База = Кластер.Получить("ИнформационнаяБаза", Объект.Спецификация.ИнформационнаяБаза, Подразделение);
	Если База = Неопределено ИЛИ База.Состояние.Зарегистрирована <> Истина Тогда
		Состояние.Фаза = "ОжидаетБазу";
		ПовторитьЧерез(60);
		Возврат;
	КонецЕсли;
	К = КластерБазы(База, Отказ);
	Если К = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяБазы = ИмяAPI(База.Метаданные.Имя);

	Если ЗначениеЗаполнено(Объект.Спецификация.Расписание) Тогда
		Скрипт = СтрШаблон("%1/ibcmd infobase dump %2 /vygruzki/%3-$(date +%%Y%%m%%d-%%H%%M).dt", К.Путь, ПараметрыБазыДанных(К, ИмяБазы), ИмяБазы);
		З = ЗаданиеСервера(К, Имя, Скрипт, Неопределено);
		Р = Новый РегламентноеЗадание(Имя, Подразделение);
		Р.Спецификация.Расписание = Объект.Спецификация.Расписание;
		Р.Спецификация.concurrencyPolicy = "Forbid";
		Р.Спецификация.ШаблонЗадания.Спецификация = З.Спецификация;
		Кластер.Провести(Р, Объект);
		Состояние.Фаза = "ПоРасписанию";
		Состояние.Файл = СтрШаблон("/vygruzki/%1-<дата>.dt на томе %2-vygruzki", ИмяБазы, К.Имя);
		Состояние.Сообщение = "Выгрузка по расписанию " + Объект.Спецификация.Расписание;
		Возврат;
	КонецЕсли;

	Файл = СтрШаблон("/vygruzki/%1-%2.dt", ИмяБазы, Имя);
	Готово = ВыполнитьЗадание(К, Имя + "-vygruzka", Объект,
		СтрШаблон("%1/ibcmd infobase dump %2 %3", К.Путь, ПараметрыБазыДанных(К, ИмяБазы), Файл), Неопределено);
	Если Готово = Неопределено Тогда
		Состояние.Фаза = "Выгружается";
		ПовторитьЧерез(15);
	ИначеЕсли Готово Тогда
		Состояние.Фаза = "Выгружена";
		Состояние.Файл = Файл;
		Состояние.Сообщение = СтрШаблон("Выгрузка лежит на томе %1-vygruzki: %2", К.Имя, Файл);
	Иначе
		Состояние.Фаза = "Ошибка";
		Состояние.Сообщение = "Задание выгрузки завершилось ошибкой.";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Выполняет команду rac в центральном сервере кластера.
Функция RAC(К, Команда)

	Ответ = Кластер.ВыполнитьВПоде(К.Имя + "-central-0", К.Подразделение,
		К.Путь + "/rac localhost:1545 " + Команда, "ragent");
	Если Ответ.КодВозврата <> 0 Тогда
		ВызватьИсключение СокрЛП(Ответ.Ошибки + " " + Ответ.Вывод);
	КонецЕсли;
	Возврат Ответ.Вывод;

КонецФункции

Функция ИдентификаторКластера(К)

	Кластеры = РазобратьRAC(RAC(К, "cluster list"));
	Если Кластеры.Количество() = 0 Тогда
		ВызватьИсключение "в агенте нет ни одного кластера";
	КонецЕсли;
	Возврат Кластеры[0].Получить("cluster");

КонецФункции

// Разбирает вывод rac: блоки «ключ : значение», разделённые пустой строкой.
Функция РазобратьRAC(Текст)

	Результат = Новый Массив;
	Текущий = Неопределено;
	Для Номер = 1 По СтрЧислоСтрок(Текст) Цикл
		Строка = СтрПолучитьСтроку(Текст, Номер);
		Если ПустаяСтрока(Строка) Тогда
			Текущий = Неопределено;
			Продолжить;
		КонецЕсли;
		Позиция = СтрНайти(Строка, " : ");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Текущий = Неопределено Тогда
			Текущий = Новый Соответствие;
			Результат.Добавить(Текущий);
		КонецЕсли;
		Значение = СокрЛП(Сред(Строка, Позиция + 3));
		Если СтрНачинаетсяС(Значение, """") И СтрЗаканчиваетсяНа(Значение, """") И СтрДлина(Значение) >= 2 Тогда
			Значение = СтрЗаменить(Сред(Значение, 2, СтрДлина(Значение) - 2), """""", """");
		КонецЕсли;
		Текущий.Вставить(СокрЛП(Лев(Строка, Позиция - 1)), Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПодГотов(Имя, Подразделение)

	Под = Кластер.Получить("Под", Имя, Подразделение);
	Если Под = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Под.Метаданные.ДатаПометкиНаУдаление) = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Условие Из Под.Состояние.Условия Цикл
		Если Условие.Тип = "Ready" Тогда
			Возврат Условие.Состояние = "True";
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция Значение(Значение, ПоУмолчанию)

	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);

КонецФункции

Процедура Команда(Контейнер, Текст)

	Контейнер.Команда.Добавить("sh");
	Контейнер.Команда.Добавить("-c");
	Контейнер.Команда.Добавить(Текст);

КонецПроцедуры

Процедура Ресурсы(Контейнер, Процессор, Память)

	Контейнер.Ресурсы.Запросы.Процессор = Процессор;
	Контейнер.Ресурсы.Запросы.Память = Память;
	Контейнер.Ресурсы.Пределы.Память = Память;

КонецПроцедуры

Процедура Переменная(Контейнер, Имя, Значение)

	П = Контейнер.Окружение.Добавить();
	П.Имя = Имя;
	П.Значение = Значение;

