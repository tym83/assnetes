// Производственный календарь.
//
// Загружает производственный календарь страны на год с xmlcalendar.ru и не даёт
// людям ничего менять в кластере в праздники, в выходные, в обед, в
// предпраздничный сокращённый день после 15:00, а ещё за неделю до майских и до
// новогодних праздников и до их конца: давайте уже после праздников. Нагрузки
// при этом работают, а Kubernetes и операторы делают своё дело. Если очень
// надо — служебная записка: аннотация «оркестратор.бух/служебная-записка» с
// обоснованием на объекте или на его подразделении.

#Область ОбработчикиСобытий

&Обработка(Вид = "ПроизводственныйКалендарь")
Процедура ОбработкаПроведения(Объект, Отказ) Экспорт

	Состояние = Объект.Состояние;
	Год = Объект.Спецификация.Год;
	Если НЕ ЗначениеЗаполнено(Год) Тогда
		Отказ = Истина;
		Сообщить("Не указан год. Календарь на какой год вести будем?");
		Возврат;
	КонецЕсли;

	Если Состояние.Свойство("Загружен") И Состояние.Год = Год Тогда
		// уже загружен: только отметить, рабочий ли сегодня день
		Состояние.СегодняРабочий = (ПричинаЗапрета(Объект, НачалоДня(ВремяКалендаря(Объект)) + 10 * 3600) = "");
		Возврат;
	КонецЕсли;

	Попытка
		Загрузить(Объект);
	Исключение
		Отказ = Истина;
		Сообщить(СтрШаблон("Календарь на %1 год не загрузился: %2. Попробую через час.",
			Формат(Год, "ЧГ=0"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		ПовторитьЧерез(3600);
	КонецПопытки;

КонецПроцедуры

// Любое изменение любого объекта и подключение к подам (exec, attach,
// port-forward) от людей: служебные учётные записи Kubernetes сюда не попадают.
&ПроверкаЗаполнения(Виды = "*", Операции = "Создание, Изменение, Удаление, Подключение")
Процедура ОбработкаПроверкиЗаполнения(Объект, Отказ, Контекст) Экспорт

	// Объекты, которые ведут контроллеры, — тоже: их создают служебные
	// учётные записи, а человеку удалить под в выходной нельзя.
	Если Объект.Вид = "ПроизводственныйКалендарь" Тогда
		Возврат; // сам календарь поправить можно всегда, иначе его не выключить
	КонецЕсли;
	Если Объект.Вид = "Подразделение" И Контекст.Операция = "Изменение" Тогда
		Возврат; // положить служебную записку на подразделение можно всегда
	КонецЕсли;

	Календари = Кластер.Выбрать("ПроизводственныйКалендарь");
	Для Каждого Календарь Из Календари Цикл
		МестноеСейчас = ВремяКалендаря(Календарь);
		Если Календарь.Спецификация.Год <> Год(МестноеСейчас) Тогда
			Продолжить;
		КонецЕсли;
		Причина = ПричинаЗапрета(Календарь, МестноеСейчас);
		Если Причина = "" Тогда
			Продолжить;
		КонецЕсли;
		Записка = Объект.Метаданные.Аннотации.Получить("оркестратор.бух/служебная-записка");
		Если НЕ ЗначениеЗаполнено(Записка) И ЗначениеЗаполнено(Контекст.Подразделение) Тогда
			// записка на всё подразделение — для того, что ставит пакетный менеджер
			Подразделение = Кластер.Получить("Подразделение", Контекст.Подразделение);
			Если Подразделение <> Неопределено Тогда
				Записка = Подразделение.Метаданные.Аннотации.Получить("оркестратор.бух/служебная-записка");
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Записка) Тогда
			Журнал.Информация(СтрШаблон("%1, но есть служебная записка от %2: «%3». Пропускаю.",
				Причина, Контекст.Пользователь, Записка));
			Возврат;
		КонецЕсли;
		Отказ = Истина;
		Сообщить(СтрШаблон("%1. Изменения запрещены производственным календарём. Если очень надо — служебная записка: аннотация «оркестратор.бух/служебная-записка» с обоснованием на объекте или на его подразделении.", Причина));
		Возврат;
	КонецЦикла;

КонецПроцедуры

&Расписание("5 0 * * *")
Процедура ОбновитьКалендари() Экспорт

	Для Каждого Календарь Из Кластер.Выбрать("ПроизводственныйКалендарь") Цикл
		Отказ = Ложь;
		ОбработкаПроведения(Календарь, Отказ);
		Если НЕ Отказ Тогда
			Кластер.ЗаписатьСостояние(Календарь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Загрузить(Объект)

	Спецификация = Объект.Спецификация;
	Страна = ?(ЗначениеЗаполнено(Спецификация.Страна), Спецификация.Страна, "ru");
	Источник = ?(ЗначениеЗаполнено(Спецификация.Источник), Спецификация.Источник, "https://xmlcalendar.ru/data");
	Год = Спецификация.Год;

	Соединение = Новый HTTPСоединение(Источник);
	Запрос = Новый HTTPЗапрос(СтрШаблон("/%1/%2/calendar.xml", Страна, Формат(Год, "ЧГ=0")));
	Ответ = Соединение.Получить(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("источник ответил %1", Ответ.КодСостояния);
	КонецЕсли;

	Праздники = Новый Соответствие;
	Дни = Новый Массив;
	ТипыДней = Новый Соответствие;
	ТипыДней.Вставить("1", "Выходной");
	ТипыДней.Вставить("2", "Сокращённый");
	ТипыДней.Вставить("3", "Рабочий");

	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		Если Чтение.Имя = "holiday" Тогда
			Праздники.Вставить(Чтение.ЗначениеАтрибута("id"), Чтение.ЗначениеАтрибута("title"));
		ИначеЕсли Чтение.Имя = "day" Тогда
			День = Новый Структура("Дата, Тип, Праздник",
				Чтение.ЗначениеАтрибута("d"),
				ТипыДней.Получить(Чтение.ЗначениеАтрибута("t")),
				"");
			КодПраздника = Чтение.ЗначениеАтрибута("h");
			Если КодПраздника <> Неопределено Тогда
				День.Праздник = Праздники.Получить(КодПраздника);
			КонецЕсли;
			Дни.Добавить(День);
		КонецЕсли;
	КонецЦикла;

	Если Дни.Количество() = 0 Тогда
		ВызватьИсключение "в календаре нет ни одного дня";
	КонецЕсли;

	Состояние = Объект.Состояние;
	Состояние.Год = Год;
	Состояние.Дни = Дни;
	Названия = Новый Массив;
	Для Каждого Праздник Из Праздники Цикл
		Названия.Добавить(Праздник.Значение);
	КонецЦикла;
	Состояние.Праздники = Названия;
	Состояние.РабочихДней = РабочихДнейВГоду(Год, Дни);
	Состояние.Загружен = XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z";
	Состояние.Сообщение = СтрШаблон("Загружен календарь %1 на %2 год: рабочих дней %3",
		ВРег(Страна), Формат(Год, "ЧГ=0"), Состояние.РабочихДней);
	Состояние.СегодняРабочий = (ПричинаЗапрета(Объект, НачалоДня(ВремяКалендаря(Объект)) + 10 * 3600) = "");
	Журнал.Информация(Состояние.Сообщение);

КонецПроцедуры

Функция РабочихДнейВГоду(Год, Дни)

	Исключения = Новый Соответствие;
	Для Каждого День Из Дни Цикл
		Исключения.Вставить(День.Дата, День.Тип);
	КонецЦикла;
	Рабочих = 0;
	ТекущийДень = Дата(Год, 1, 1);
	Пока Год(ТекущийДень) = Год Цикл
		Тип = Исключения.Получить(Формат(ТекущийДень, "ДФ=MM.dd"));
		Если Тип = Неопределено Тогда
			Тип = ?(ДеньНедели(ТекущийДень) >= 6, "Выходной", "Рабочий");
		КонецЕсли;
		Если Тип <> "Выходной" Тогда
			Рабочих = Рабочих + 1;
		КонецЕсли;
		ТекущийДень = ТекущийДень + 86400;
	КонецЦикла;
	Возврат Рабочих;

КонецФункции

// Почему сейчас выкатывать нельзя; пустая строка — можно.
Функция ПричинаЗапрета(Календарь, Сейчас)

	Правила = Календарь.Спецификация.ЗапретВыкатки;
	ВПраздники = ?(Правила.Свойство("ВПраздники"), Правила.ВПраздники, Истина);
	ВВыходные = ?(Правила.Свойство("ВВыходные"), Правила.ВВыходные, Истина);
	ПослеЧасаСокращённого = ?(Правила.Свойство("ВСокращённыйДеньПослеЧаса"), Правила.ВСокращённыйДеньПослеЧаса, 15);
	ПослеЧасаПятницы = ?(Правила.Свойство("ВПятницуПослеЧаса"), Правила.ВПятницуПослеЧаса, 24);
	ОбедС = ?(Правила.Свойство("ОбедСЧаса"), Правила.ОбедСЧаса, 13);
	ОбедДо = ?(Правила.Свойство("ОбедДоЧаса"), Правила.ОбедДоЧаса, 14);

	Заморозка = Заморозка(Календарь, Сейчас);
	Если Заморозка <> "" Тогда
		Возврат Заморозка;
	КонецЕсли;

	ДеньМесяц = Формат(Сейчас, "ДФ=MM.dd");
	Тип = ?(ДеньНедели(Сейчас) >= 6, "Выходной", "Рабочий");
	Праздник = "";
	Для Каждого День Из Календарь.Состояние.Дни Цикл
		Если День.Дата = ДеньМесяц Тогда
			Тип = День.Тип;
			Праздник = ?(День.Свойство("Праздник"), День.Праздник, "");
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Когда = Формат(Сейчас, "ДФ='d MMMM'");
	Если Тип = "Выходной" Тогда
		Если ЗначениеЗаполнено(Праздник) И ВПраздники Тогда
			Возврат СтрШаблон("Сегодня %1 — %2", Когда, Праздник);
		ИначеЕсли ВВыходные Тогда
			Возврат СтрШаблон("Сегодня %1, выходной", Когда);
		КонецЕсли;
	ИначеЕсли Час(Сейчас) >= ОбедС И Час(Сейчас) < ОбедДо Тогда
		Возврат СтрШаблон("Обед с %1:00 до %2:00, а сейчас %3. Кластер на обеде, касса откроется в %2:00",
			Формат(ОбедС, "ЧГ=0"), Формат(ОбедДо, "ЧГ=0"), Формат(Сейчас, "ДФ=HH:mm"));
	ИначеЕсли Тип = "Сокращённый" И Час(Сейчас) >= ПослеЧасаСокращённого Тогда
		Возврат СтрШаблон("Сегодня %1 — предпраздничный сокращённый день, а уже %2", Когда, Формат(Сейчас, "ДФ=HH:mm"));
	ИначеЕсли ДеньНедели(Сейчас) = 5 И Час(Сейчас) >= ПослеЧасаПятницы Тогда
		Возврат СтрШаблон("Пятница, %1. Кто выкатывает в пятницу вечером, тот работает в субботу", Формат(Сейчас, "ДФ=HH:mm"));
	КонецЕсли;
	Возврат "";

КонецФункции

// Перед майскими и новогодними праздниками изменения откладываются: с
// недели до первого выходного и до последнего. У майских это выходные
// вокруг 1 и 9 мая, у новогодних — с 31 декабря, если он выходной, и
// январские каникулы.
Функция Заморозка(Календарь, Сейчас)

	Правила = Календарь.Спецификация.ЗапретВыкатки;
	ПередМайскими = ?(Правила.Свойство("ПередМайскими"), Правила.ПередМайскими, Истина);
	ПередНовымГодом = ?(Правила.Свойство("ПередНовымГодом"), Правила.ПередНовымГодом, Истина);
	Дней = ?(Правила.Свойство("ДнейДоПраздников"), Правила.ДнейДоПраздников, 7);
	Сегодня = НачалоДня(Сейчас);
	Год = Год(Сейчас);
	Когда = Формат(Сегодня, "ДФ='d MMMM'");

	Если ПередМайскими Тогда
		Начало = НачалоВыходных(Календарь, Дата(Год, 5, 1));
		Конец = КонецВыходных(Календарь, Дата(Год, 5, 9));
		Если Сегодня >= Начало - Дней * 86400 И Сегодня <= Конец Тогда
			Возврат СтрШаблон("Сегодня %1, %2. Давайте уже после майских, с %3",
				Когда, ?(Сегодня < Начало, "на носу майские", "майские"), Формат(Конец + 86400, "ДФ='d MMMM'"));
		КонецЕсли;
	КонецЕсли;

	Если ПередНовымГодом Тогда
		Если ТипДня(Календарь, Дата(Год, 12, 31)) = "Выходной" Тогда
			Начало = НачалоВыходных(Календарь, Дата(Год, 12, 31));
		Иначе
			Начало = Дата(Год, 12, 31) + 86400;
		КонецЕсли;
		КонецКаникул = КонецВыходных(Календарь, Дата(Год, 1, 1));
		Если Сегодня >= Начало - Дней * 86400 ИЛИ Сегодня <= КонецКаникул Тогда
			Возврат СтрШаблон("Сегодня %1, %2. Давайте уже после праздников",
				Когда, ?(Сегодня <= КонецКаникул, "каникулы", "на носу Новый год"));
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// Тип дня: из загруженного календаря, а если день там не упомянут — по дню недели.
Функция ТипДня(Календарь, День)

	ДеньМесяц = Формат(День, "ДФ=MM.dd");
	Если Год(День) = Календарь.Спецификация.Год Тогда
		Для Каждого Д Из Календарь.Состояние.Дни Цикл
			Если Д.Дата = ДеньМесяц Тогда
				Возврат Д.Тип;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ?(ДеньНедели(День) >= 6, "Выходной", "Рабочий");

КонецФункции

Функция НачалоВыходных(Календарь, День)

	Пока ТипДня(Календарь, День - 86400) = "Выходной" Цикл
		День = День - 86400;
	КонецЦикла;
	Возврат День;

КонецФункции

Функция КонецВыходных(Календарь, День)

	Пока ТипДня(Календарь, День + 86400) = "Выходной" Цикл
		День = День + 86400;
	КонецЦикла;
	Возврат День;

КонецФункции

Функция ВремяКалендаря(Календарь)

	Пояс = Календарь.Спецификация.ЧасовойПояс;
	Если НЕ ЗначениеЗаполнено(Пояс) Тогда
		Пояс = "Europe/Moscow";
	КонецЕсли;
	Возврат МестноеВремя(ТекущаяУниверсальнаяДата(), Пояс);

КонецФункции

#КонецОбласти
