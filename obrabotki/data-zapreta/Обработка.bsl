// Дата запрета изменения данных.
//
// Как в типовых конфигурациях: подразделению ставится дата запрета —
// аннотация «оркестратор.бух/дата-запрета» на Подразделении, например
// «2026-10-01». Объекты, проведённые до этой даты, после неё нельзя ни
// перепровести, ни удалить. Можно только главному бухгалтеру: группе из
// аннотации «оркестратор.бух/главбух» (по умолчанию — glavbuh) и
// администраторам кластера.

#Область ОбработчикиСобытий

&ПроверкаЗаполнения(Виды = "Развёртывание, НаборСоСостоянием, НаборНаКаждомУзле, Услуга, Проходная, Справочник, Секрет, РегламентноеЗадание, ЗаявкаНаТом", Операции = "Изменение, Удаление")
Процедура ОбработкаПроверкиЗаполнения(Объект, Отказ, Контекст) Экспорт

	Если НЕ ЗначениеЗаполнено(Контекст.Подразделение) Тогда
		Возврат;
	КонецЕсли;

	Подразделение = Кластер.Получить("Подразделение", Контекст.Подразделение);
	Если Подразделение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Аннотации = Подразделение.Метаданные.Аннотации;
	ДатаЗапретаСтрокой = Аннотации.Получить("оркестратор.бух/дата-запрета");
	Если НЕ ЗначениеЗаполнено(ДатаЗапретаСтрокой) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ДатаЗапрета = XMLЗначение(Тип("Дата"), ДатаЗапретаСтрокой);
	Исключение
		Журнал.Предупреждение(СтрШаблон("В подразделении %1 дата запрета «%2» не читается — запрет не действует",
			Контекст.Подразделение, ДатаЗапретаСтрокой));
		Возврат;
	КонецПопытки;

	Проведён = XMLЗначение(Тип("Дата"), Объект.Метаданные.ДатаСоздания);
	Если Проведён >= ДатаЗапрета Тогда
		Возврат; // документ нового периода
	КонецЕсли;

	Если Контекст.Операция = "Изменение"
		И ДанныеСовпадают(Объект.Спецификация, Контекст.СтарыйОбъект.Спецификация)
		И ДанныеСовпадают(Объект.Данные, Контекст.СтарыйОбъект.Данные) Тогда
		Возврат; // поменялись метки или служебные поля: это не правка учёта
	КонецЕсли;

	ГруппаГлавбуха = Аннотации.Получить("оркестратор.бух/главбух");
	Если НЕ ЗначениеЗаполнено(ГруппаГлавбуха) Тогда
		ГруппаГлавбуха = "glavbuh";
	КонецЕсли;
	Для Каждого Группа Из Контекст.Группы Цикл
		Если Группа = ГруппаГлавбуха ИЛИ Группа = "system:masters" Тогда
			Журнал.Информация(СтрШаблон("%1 правит закрытый период в %2: %3 «%4». Главбуху можно.",
				Контекст.Пользователь, Контекст.Подразделение, Объект.Вид, Объект.Метаданные.Имя));
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Отказ = Истина;
	Сообщить(СтрШаблон("Период закрыт. Дата запрета изменения данных: %1, а %2 «%3» проведён %4. %5 — обратитесь к главному бухгалтеру.",
		Формат(ДатаЗапрета, "ДЛФ=D"), Объект.Вид, Объект.Метаданные.Имя, Формат(Проведён, "ДЛФ=D"),
		?(Контекст.Операция = "Удаление", "Удалить", "Изменить")));

КонецПроцедуры

#КонецОбласти
