Функция ПричинаНеРазнесено(Перепроведение)

	Для Каждого Условие Из Перепроведение.Состояние.Условия Цикл
		Если Условие.Тип = "Ready" И ЗначениеЗаполнено(Условие.Сообщение) Тогда
			Возврат "Flux: " + Условие.Сообщение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура СверитьДокумент(Документ, Расхождения)

	Представление = СтрШаблон("%1 «%2»", Документ.Вид, Документ.Метаданные.Имя);
	Наш = Кластер.Получить(Документ.Вид, Документ.Метаданные.Имя, Документ.Метаданные.Подразделение);
	Если Наш = Неопределено Тогда
		Добавить(Расхождения, Представление, "весь документ", "есть", "нет");
		Возврат;
	КонецЕсли;
	Для Каждого Поле Из Документ Цикл
		Если Поле.Ключ = "Вид" ИЛИ Поле.Ключ = "ВерсияAPI" ИЛИ Поле.Ключ = "Состояние" Тогда
			Продолжить;
		КонецЕсли;
		Сверить(Представление, Поле.Ключ, Поле.Значение, Наш.Получить(Поле.Ключ), Расхождения);
	КонецЦикла;

КонецПроцедуры

// Сравнивает учёт с кластером. Лишнее в кластере — не расхождение:
// значения по умолчанию кластер дописывает сам.
Процедура Сверить(Документ, Путь, ПоУчёту, ВКластере, Расхождения)

	Если ТипЗнч(ПоУчёту) = Тип("ОбъектКластера") Тогда
		Если ТипЗнч(ВКластере) <> Тип("ОбъектКластера") Тогда
			Добавить(Расхождения, Документ, Путь, "заполнено", "нет");
			Возврат;
		КонецЕсли;
		Если Путь = "Метаданные" Тогда
			Сверить(Документ, Путь + ".Метки", ПоУчёту.Метки, ВКластере.Метки, Расхождения);
			Возврат;
		КонецЕсли;
		Для Каждого Поле Из ПоУчёту Цикл
			Сверить(Документ, Путь + "." + Поле.Ключ, Поле.Значение, ВКластере.Получить(Поле.Ключ), Расхождения);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПоУчёту) = Тип("СписокОбъектаКластера") Тогда
		Если ТипЗнч(ВКластере) <> Тип("СписокОбъектаКластера") ИЛИ ВКластере.Количество() <> ПоУчёту.Количество() Тогда
			Добавить(Расхождения, Документ, Путь,
				СтрШаблон("%1 шт.", ПоУчёту.Количество()),
				?(ТипЗнч(ВКластере) = Тип("СписокОбъектаКластера"), СтрШаблон("%1 шт.", ВКластере.Количество()), "нет"));
			Возврат;
		КонецЕсли;
		Для Номер = 0 По ПоУчёту.Количество() - 1 Цикл
			Сверить(Документ, СтрШаблон("%1[%2]", Путь, Номер), ПоУчёту[Номер], ВКластере[Номер], Расхождения);
		КонецЦикла;
	ИначеЕсли XMLСтрока(ПоУчёту) <> XMLСтрока(ВКластере) Тогда
		Добавить(Расхождения, Документ, Путь, XMLСтрока(ПоУчёту), ?(ВКластере = Неопределено, "нет", XMLСтрока(ВКластере)));
	КонецЕсли;

КонецПроцедуры

Процедура Добавить(Расхождения, Документ, Поле, ПоУчёту, ВКластере)

	Расхождения.Добавить(Новый Структура("Документ, Поле, ПоУчёту, ВКластере", Документ, Поле, ПоУчёту, ВКластере));

КонецПроцедуры

