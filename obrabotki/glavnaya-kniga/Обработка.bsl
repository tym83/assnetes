#Область Учёт

Функция ПланСчетов(Книга)

	План = Новый Соответствие;
	Для Каждого Счёт Из Книга.Спецификация.ПланСчетов Цикл
		План.Вставить(Строка(Счёт.Код), ?(ЗначениеЗаполнено(Счёт.Вид), Счёт.Вид, "Активный"));
	КонецЦикла;
	Возврат План;

КонецФункции

Функция ДатаЗапрета(Книга)

	Возврат ?(ЗначениеЗаполнено(Книга.Спецификация.ДатаЗапрета), Лев(Книга.Спецификация.ДатаЗапрета, 10), "");

КонецФункции

// «01/Витрина» — счёт 01, субконто «Витрина».
Функция КодСчёта(Счёт)

	Позиция = СтрНайти(Счёт, "/");
	Возврат СокрЛП(?(Позиция = 0, Счёт, Лев(Счёт, Позиция - 1)));

КонецФункции

// ОперацииКниги — операции книги в порядке дат, а в один день — в порядке
// записи в журнал.
Функция ОперацииКниги(Книга)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Дата");
	Таблица.Колонки.Добавить("Записана");
	Таблица.Колонки.Добавить("Имя");
	Таблица.Колонки.Добавить("Операция");
	ИмяКниги = ИмяAPI(Книга.Метаданные.Имя);
	Для Каждого Операция Из Кластер.Выбрать("Операция", , Книга.Метаданные.Подразделение) Цикл
		Если ИмяAPI(Операция.Спецификация.Книга) <> ИмяКниги Тогда
			Продолжить;
		КонецЕсли;
		Ряд = Таблица.Добавить();
		Ряд.Дата = Лев(Операция.Спецификация.Дата, 10);
		Ряд.Записана = Операция.Метаданные.ДатаСоздания;
		Ряд.Имя = ИмяAPI(Операция.Метаданные.Имя);
		Ряд.Операция = Операция;
	КонецЦикла;
	Таблица.Сортировать("Дата, Записана, Имя");
	Операции = Новый Массив;
	Для Каждого Ряд Из Таблица Цикл
		Операции.Добавить(Ряд.Операция);
	КонецЦикла;
	Возврат Операции;

КонецФункции

Функция НоваяТаблицаПроводок()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Счёт");
	Таблица.Колонки.Добавить("Сумма");
	Возврат Таблица;

КонецФункции

Процедура ДобавитьПроводку(Таблица, Счёт, Сумма)

	Ряд = Таблица.Добавить();
	Ряд.Счёт = Счёт;
	Ряд.Сумма = Сумма;
	Если КодСчёта(Счёт) <> Счёт Тогда
		Ряд = Таблица.Добавить(); // и на сам счёт, без субконто
		Ряд.Счёт = КодСчёта(Счёт);
		Ряд.Сумма = Сумма;
	КонецЕсли;

КонецПроцедуры

// СальдоПоСчетам: остаток по каждому счёту и субконто, как его читают:
// у активного — дебетовый, у пассивного — кредитовый.
Функция СальдоПоСчетам(Проводки, План)

	Свёрнутые = Проводки.Скопировать();
	Свёрнутые.Свернуть("Счёт", "Сумма");
	Сальдо = Новый Соответствие;
	Для Каждого Ряд Из Свёрнутые Цикл
		Сальдо.Вставить(Ряд.Счёт, ?(План.Получить(КодСчёта(Ряд.Счёт)) = "Пассивный", -Ряд.Сумма, Ряд.Сумма));
	КонецЦикла;
	Возврат Сальдо;

КонецФункции

Функция ТаблицаОстатков(Проводки, План)

	Сальдо = СальдоПоСчетам(Проводки, План);
	Свёрнутые = Проводки.Скопировать();
	Свёрнутые.Свернуть("Счёт", "Сумма");
	Свёрнутые.Сортировать("Счёт");
	Остатки = Новый Массив;
	Для Каждого Ряд Из Свёрнутые Цикл
		Остатки.Добавить(Новый Структура("Счёт, Сальдо", Ряд.Счёт, Сальдо.Получить(Ряд.Счёт)));
	КонецЦикла;
	Возврат Остатки;

КонецФункции

Процедура ОтметитьОперацию(Операция, Решение, СторнированаОперацией)

	Состояние = Операция.Состояние;
	Кем = ?(ЗначениеЗаполнено(СторнированаОперацией), СторнированаОперацией, "");
	Если Состояние.Учтена = Решение.Учтена И Строка(Состояние.Причина) = Решение.Причина
		И Строка(Состояние.Отпечаток) = Решение.Отпечаток И Строка(Состояние.СторнированаОперацией) = Кем Тогда
		Возврат;
	КонецЕсли;
	Впервые = Состояние.Учтена <> Решение.Учтена ИЛИ Строка(Состояние.Причина) <> Решение.Причина;
	Состояние.Учтена = Решение.Учтена;
	Состояние.Причина = Решение.Причина;
	Состояние.Отпечаток = Решение.Отпечаток;
	Состояние.СторнированаОперацией = Кем;
	Кластер.ЗаписатьСостояние(Операция);
	Если НЕ Впервые Тогда
		Возврат;
	ИначеЕсли Решение.Учтена Тогда
		Кластер.ЗаписатьСобытие(Операция, "Информация", "Учтена", СтрШаблон("Операция учтена в книге «%1»", Операция.Спецификация.Книга));
	Иначе
		Кластер.ЗаписатьСобытие(Операция, "Предупреждение", "НеУчтена", Решение.Причина);
	КонецЕсли;

