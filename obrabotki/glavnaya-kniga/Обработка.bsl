// Главная книга. БухОпс.
//
// Источник истины кластера — не коммиты, а журнал хозяйственных операций.
// Операция несёт проводки Дт/Кт и, если нужно, первичный документ —
// манифест на языке 1С, в котором Сальдо("01/Витрина") даёт остаток по
// счёту. Книга учитывает операции с двумя подписями, считает остатки,
// проводит по ним первичку и публикует то, что получилось, выпиской для
// Flux (ExternalArtifact). Групповое перепроведение (Kustomization)
// разносит выписку по кластеру, а книга раз в минуту сверяет кластер с
// учётом.
//
// Правила учёта:
//   - операции не меняют и не удаляют, ошибку исправляет сторно —
//     операция с теми же проводками и суммами с минусом;
//   - у каждой проводки два счёта, у операции две подписи: автор и
//     утвердивший, и это разные люди;
//   - в закрытый период (до даты запрета) операции не принимаются;
//   - учтённую операцию переписать нельзя: книга помнит её отпечаток и,
//     если документ поменяли в обход проверок, перестаёт публиковать
//     выписки до разбирательства.

#Область ОбработчикиСобытий

&Обработка(Вид = "ГлавнаяКнига", Наблюдает = "Операция")
Процедура ОбработкаПроведения(Книга, Отказ) Экспорт

	Спецификация = Книга.Спецификация;
	Минут = ?(ЗначениеЗаполнено(Спецификация.ПериодичностьСверкиМинут), Спецификация.ПериодичностьСверкиМинут, 1);
	ПовторитьЧерез(Минут * 60);

	Подразделение = Книга.Метаданные.Подразделение;
	План = ПланСчетов(Книга);
	ДатаЗапрета = ДатаЗапрета(Книга);
	ПодразделениеДокументов = ?(ЗначениеЗаполнено(Спецификация.Подразделение), Спецификация.Подразделение, Подразделение);

	// Учёт: операции в порядке дат, каждая — учтена или нет и почему.
	Учтённые = Новый Массив;
	Сторнированные = Новый Соответствие; // операция → чьё сторно
	ПоИмени = Новый Соответствие;
	Нарушения = Новый Массив;
	НеУчтено = 0;
	Проводки = НоваяТаблицаПроводок();

	Операции = ОперацииКниги(Книга);
	Решения = Новый Соответствие;
	Для Каждого Операция Из Операции Цикл
		Имя = ИмяAPI(Операция.Метаданные.Имя);
		Состояние = Операция.Состояние;
		Отпечаток = Отпечаток(Операция.Спецификация);

		Если Состояние.Учтена = Истина Тогда
			Если Состояние.Отпечаток <> Отпечаток Тогда
				Нарушения.Добавить(СтрШаблон("операция «%1» исправлена после учёта", Операция.Метаданные.Имя));
				Продолжить;
			КонецЕсли;
			Причина = "";
		Иначе
			Причина = ПричинаНеУчитывать(Операция, План, ДатаЗапрета, ПоИмени, Сторнированные, Спецификация.Подписанты, ПодразделениеДокументов);
		КонецЕсли;

		Если Причина = "" Тогда
			Учтённые.Добавить(Операция);
			ПоИмени.Вставить(Имя, Операция);
			Для Каждого П Из Операция.Спецификация.Проводки Цикл
				ДобавитьПроводку(Проводки, П.Дт, П.Сумма);
				ДобавитьПроводку(Проводки, П.Кт, -П.Сумма);
			КонецЦикла;
			Если ЗначениеЗаполнено(Операция.Спецификация.Сторнирует) Тогда
				Сторнированные.Вставить(ИмяAPI(Операция.Спецификация.Сторнирует), Операция.Метаданные.Имя);
			КонецЕсли;
		Иначе
			НеУчтено = НеУчтено + 1;
		КонецЕсли;
		Решения.Вставить(Имя, Новый Структура("Учтена, Причина, Отпечаток", Причина = "", Причина, ?(Причина = "", Отпечаток, "")));
	КонецЦикла;

	// Решение и то, кем операция сторнирована, — в самой операции.
	Для Каждого Операция Из Операции Цикл
		Имя = ИмяAPI(Операция.Метаданные.Имя);
		Решение = Решения.Получить(Имя);
		Если Решение <> Неопределено Тогда
			ОтметитьОперацию(Операция, Решение, Сторнированные.Получить(Имя));
		КонецЕсли;
	КонецЦикла;

	Сальдо = СальдоПоСчетам(Проводки, План);

	Состояние = Книга.Состояние;
	Состояние.УчтеноОпераций = Учтённые.Количество();
	Состояние.НеУчтеноОпераций = НеУчтено;
	Состояние.Остатки = ТаблицаОстатков(Проводки, План);

	Если Нарушения.Количество() > 0 Тогда
		// Выписку по испорченной книге не публикуем: Flux остаётся на
		// последней честной.
		Состояние.Сообщение = "Книга не публикуется до проверки аудитором: " + СтрСоединить(Нарушения, "; ") + ". Исправления — только сторно.";
		Отказ = Истина;
		Сообщить(Состояние.Сообщение);
		Возврат;
	КонецЕсли;

	// Первичка: каждый документ — в редакции последней учтённой и не
	// сторнированной операции, которая его проводит.
	Документы = Новый Соответствие;
	Метка = "";
	Для Каждого Операция Из Учтённые Цикл
		Метка = Операция.Метаданные.Имя;
		Если НЕ ЗначениеЗаполнено(Операция.Спецификация.Первичка)
			ИЛИ ЗначениеЗаполнено(Сторнированные.Получить(ИмяAPI(Операция.Метаданные.Имя))) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Документ Из ВыполнитьМанифест(Операция.Спецификация.Первичка, Неопределено, Сальдо, ПодразделениеДокументов) Цикл
			Документы.Вставить(КлючДокумента(Документ), Документ);
		КонецЦикла;
	КонецЦикла;
	Массив = Новый Массив;
	Для Каждого Пара Из Документы Цикл
		Массив.Добавить(Пара.Значение);
	КонецЦикла;

	Выписка = ОпубликоватьВыписку(Книга, Массив, Метка);
	Состояние.Ревизия = Выписка.Ревизия;
	Состояние.Выписка = Выписка.Адрес;

	Перепроведение = Новый ГрупповоеПерепроведение(Книга.Метаданные.Имя, Подразделение);
	Перепроведение.Спецификация.СсылкаНаИсточник.Вид = "ExternalArtifact";
	Перепроведение.Спецификация.СсылкаНаИсточник.Имя = ИмяAPI(Книга.Метаданные.Имя);
	Перепроведение.Спецификация.Путь = "./";
	Перепроведение.Спецификация.Подчищать = Истина;
	Перепроведение.Спецификация.Интервал = ?(ЗначениеЗаполнено(Спецификация.ИнтервалРазноски), Спецификация.ИнтервалРазноски, "5m");
	Перепроведение = Кластер.Провести(Перепроведение, Книга);
	Состояние.Разнесено = (Перепроведение.Состояние.РазнесённаяРевизия = Выписка.Ревизия);

	// Сверка: кластер против учёта.
	Расхождения = Новый Массив;
	Для Каждого Документ Из Массив Цикл
		СверитьДокумент(Документ, Расхождения);
	КонецЦикла;
	Состояние.ДатаСверки = XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z";
	Состояние.Расхождений = Расхождения.Количество();
	Состояние.Сошлось = (Расхождения.Количество() = 0);
	Показать = Новый Массив;
	Для Каждого Расхождение Из Расхождения Цикл
		Если Показать.Количество() = 50 Тогда
			Прервать;
		КонецЕсли;
		Показать.Добавить(Расхождение);
	КонецЦикла;
	Состояние.Расхождения = Показать;

	Если НЕ Состояние.Разнесено Тогда
		Состояние.Сообщение = СтрШаблон("Выписка %1 сформирована, ждём разноски. %2", Выписка.Ревизия, ПричинаНеРазнесено(Перепроведение));
	ИначеЕсли Состояние.Сошлось Тогда
		Состояние.Сообщение = СтрШаблон("Учтено операций: %1. Документов: %2. Кластер сходится с учётом.", Учтённые.Количество(), Массив.Количество());
	Иначе
		Состояние.Сообщение = СтрШаблон("Расхождений со сверкой: %1. Flux перепроведёт кластер по учёту.", Расхождения.Количество());
	КонецЕсли;

КонецПроцедуры

// Операции: только новые — изменить проведённую нельзя, удалить нельзя.
&ПроверкаЗаполнения(Виды = "Операция", Операции = "Создание, Изменение, Удаление")
Процедура ПроверкаОперации(Операция, Отказ, Контекст) Экспорт

	Если СлужебныйПользователь(Контекст.Пользователь) Тогда
		Возврат;
	КонецЕсли;

	Если Контекст.Операция = "Удаление" Тогда
		Отказ = Истина;
		Сообщить(СтрШаблон("Операции из журнала не удаляют. Ошибку исправляет сторно: 1сctl учёт сторно %1", Операция.Метаданные.Имя));
		Возврат;
	КонецЕсли;

	Книга = Кластер.Получить("ГлавнаяКнига", Операция.Спецификация.Книга, Контекст.Подразделение);
	Если Книга = Неопределено Тогда
		Отказ = Истина;
		Сообщить(СтрШаблон("Главной книги «%1» в подразделении нет. Сначала откройте книгу, потом пишите в неё.", Операция.Спецификация.Книга));
		Возврат;
	КонецЕсли;
	ДатаЗапрета = ДатаЗапрета(Книга);

	Если Контекст.Операция = "Изменение" Тогда
		Старая = Контекст.СтарыйОбъект;
		Утвердил = Строка(Операция.Спецификация.Утвердил);
		БылУтвердил = Строка(Старая.Спецификация.Утвердил);
		Операция.Спецификация.Утвердил = БылУтвердил;
		ТолькоПодпись = ДанныеСовпадают(Операция.Спецификация, Старая.Спецификация);
		Операция.Спецификация.Утвердил = Утвердил;
		Если ТолькоПодпись И Утвердил = БылУтвердил Тогда
			Возврат; // поменялись метки или служебные поля
		КонецЕсли;
		Если НЕ ТолькоПодпись Тогда
			Отказ = Истина;
			Сообщить(СтрШаблон("Операция «%1» уже в журнале, её не исправляют. Ошибку исправляет сторно и новая операция: 1сctl учёт сторно %1", Операция.Метаданные.Имя));
			Возврат;
		КонецЕсли;
		Если БылУтвердил <> "" Тогда
			Отказ = Истина;
			Сообщить(СтрШаблон("Операцию «%1» уже утвердил %2. Вторую подпись не переставляют.", Операция.Метаданные.Имя, БылУтвердил));
			Возврат;
		КонецЕсли;
		Если Утвердил <> Контекст.Пользователь Тогда
			Отказ = Истина;
			Сообщить(СтрШаблон("Подписывают своей рукой: в операции подпись %1, а подписывает %2.", Утвердил, Контекст.Пользователь));
			Возврат;
		КонецЕсли;
		Ошибка = ОшибкаПодписи(Операция, Утвердил, Книга.Спецификация.Подписанты);
		Если Ошибка = "" И Лев(Операция.Спецификация.Дата, 10) < ДатаЗапрета Тогда
			Ошибка = СтрШаблон("Период закрыт: дата запрета %1, а операция от %2. Подписывать задним числом нельзя.", ДатаЗапрета, Лев(Операция.Спецификация.Дата, 10));
		КонецЕсли;
		Если Ошибка <> "" Тогда
			Отказ = Истина;
			Сообщить(Ошибка);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Создание.
	Если Операция.Спецификация.Автор <> Контекст.Пользователь Тогда
		Отказ = Истина;
		Сообщить(СтрШаблон("Автор операции — %1, а проводит её %2. Расписываются за себя.",
			?(ЗначениеЗаполнено(Операция.Спецификация.Автор), Операция.Спецификация.Автор, "никто"), Контекст.Пользователь));
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Операция.Спецификация.Утвердил) Тогда
		Отказ = Истина;
		Сообщить("Операцию утверждают после составления, вторым человеком: 1сctl учёт утвердить " + Операция.Метаданные.Имя);
		Возврат;
	КонецЕсли;

	Ошибка = ОшибкаСодержания(Операция, ПланСчетов(Книга), ДатаЗапрета,
		?(ЗначениеЗаполнено(Книга.Спецификация.Подразделение), Книга.Спецификация.Подразделение, Контекст.Подразделение));
	Если Ошибка = "" И ЗначениеЗаполнено(Операция.Спецификация.Сторнирует) Тогда
		Ошибка = ОшибкаСторноВЖурнале(Операция, Книга);
	КонецЕсли;
	Если Ошибка <> "" Тогда
		Отказ = Истина;
		Сообщить(Ошибка);
	КонецЕсли;

КонецПроцедуры

// Главная книга: период не открывают обратно без главбуха, книгу не
// уничтожают.
&ПроверкаЗаполнения(Виды = "ГлавнаяКнига", Операции = "Изменение, Удаление")
Процедура ПроверкаКниги(Книга, Отказ, Контекст) Экспорт

	Если СлужебныйПользователь(Контекст.Пользователь) Тогда
		Возврат;
	КонецЕсли;

	Если Контекст.Операция = "Удаление" Тогда
		Отказ = Истина;
		Сообщить(СтрШаблон("Главную книгу «%1» не удаляют: регистры бухгалтерского учёта хранятся не меньше пяти лет (402-ФЗ, ст. 29).", Книга.Метаданные.Имя));
		Возврат;
	КонецЕсли;

	Старая = Контекст.СтарыйОбъект;
	Главбух = Подписант(Контекст.Пользователь, Старая.Спецификация.Подписанты);
	Была = ДатаЗапрета(Старая);
	Стала = ДатаЗапрета(Книга);
	Если Стала < Была И НЕ Главбух Тогда
		Отказ = Истина;
		Сообщить(СтрШаблон("Период по %1 закрыт. Открыть его обратно может только тот, кто подписывает операции книги, а %2 не из них.", Была, Контекст.Пользователь));
	ИначеЕсли НЕ ДанныеСовпадают(Книга.Спецификация.Подписанты, Старая.Спецификация.Подписанты) И НЕ Главбух Тогда
		Отказ = Истина;
		Сообщить(СтрШаблон("Право подписи даёт тот, у кого оно есть, а %1 не подписывает операции книги.", Контекст.Пользователь));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПравилаУчёта

// ПричинаНеУчитывать: пустая строка, если операцию можно учесть.
Функция ПричинаНеУчитывать(Операция, План, ДатаЗапрета, Учтённые, Сторнированные, Подписанты, Подразделение)

	Спецификация = Операция.Спецификация;
	Если НЕ ЗначениеЗаполнено(Спецификация.Утвердил) Тогда
		Возврат "ждёт второй подписи";
	КонецЕсли;
	Ошибка = ОшибкаПодписи(Операция, Спецификация.Утвердил, Подписанты);
	Если Ошибка <> "" Тогда
		Возврат Ошибка;
	КонецЕсли;
	Ошибка = ОшибкаСодержания(Операция, План, ДатаЗапрета, Подразделение);
	Если Ошибка <> "" Тогда
		Возврат Ошибка;
	КонецЕсли;
	Если ЗначениеЗаполнено(Спецификация.Сторнирует) Тогда
		Исходная = Учтённые.Получить(ИмяAPI(Спецификация.Сторнирует));
		Если Исходная = Неопределено Тогда
			Возврат СтрШаблон("сторнируемая операция «%1» не учтена", Спецификация.Сторнирует);
		КонецЕсли;
		Кем = Сторнированные.Получить(ИмяAPI(Спецификация.Сторнирует));
		Если ЗначениеЗаполнено(Кем) Тогда
			Возврат СтрШаблон("операция «%1» уже сторнирована операцией «%2»", Спецификация.Сторнирует, Кем);
		КонецЕсли;
		Возврат ОшибкаСторно(Операция, Исходная);
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ОшибкаПодписи(Операция, Утвердил, Подписанты)

	Если Утвердил = Операция.Спецификация.Автор Тогда
		Возврат СтрШаблон("%1 составил операцию и сам её утвердил: вторая подпись — другого человека", Утвердил);
	КонецЕсли;
	Если НЕ Подписант(Утвердил, Подписанты) Тогда
		Возврат СтрШаблон("%1 не подписывает операции этой книги", Утвердил);
	КонецЕсли;
	Возврат "";

КонецФункции

Функция Подписант(Пользователь, Подписанты)

	Если НЕ ЗначениеЗаполнено(Подписанты) Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Подписант Из Подписанты Цикл
		Если Подписант = Пользователь Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ОшибкаСодержания проверяет то, что видно в самой операции: дату,
// счета, суммы и первичку.
Функция ОшибкаСодержания(Операция, План, ДатаЗапрета, Подразделение)

	Спецификация = Операция.Спецификация;
	Дата = Лев(Спецификация.Дата, 10);
	Если Дата < ДатаЗапрета Тогда
		Возврат СтрШаблон("Период закрыт: дата запрета изменения данных %1, а операция от %2. Проводите текущим периодом, ошибки прошлого — сторно.", ДатаЗапрета, Дата);
	КонецЕсли;
	Сторно = ЗначениеЗаполнено(Спецификация.Сторнирует);
	Если НЕ ЗначениеЗаполнено(Спецификация.Проводки) И НЕ ЗначениеЗаполнено(Спецификация.Первичка) Тогда
		Возврат "Пустая операция: ни проводок, ни первички.";
	КонецЕсли;
	Номер = 0;
	Для Каждого П Из Спецификация.Проводки Цикл
		Номер = Номер + 1;
		Если НЕ ЗначениеЗаполнено(П.Дт) ИЛИ НЕ ЗначениеЗаполнено(П.Кт) Тогда
			Возврат СтрШаблон("Проводка %1: у проводки два счёта, дебет и кредит.", Номер);
		КонецЕсли;
		Если П.Дт = П.Кт Тогда
			Возврат СтрШаблон("Проводка %1: дебет и кредит на одном счёте %2 — это не проводка, а самообман.", Номер, П.Дт);
		КонецЕсли;
		Для Каждого Счёт Из СтрРазделить(П.Дт + "," + П.Кт, ",") Цикл
			Если План.Получить(КодСчёта(Счёт)) = Неопределено Тогда
				Возврат СтрШаблон("Проводка %1: счёта %2 нет в плане счетов книги.", Номер, КодСчёта(Счёт));
			КонецЕсли;
		КонецЦикла;
		Если П.Сумма = 0 Тогда
			Возврат СтрШаблон("Проводка %1: сумма нулевая.", Номер);
		КонецЕсли;
		Если П.Сумма < 0 И НЕ Сторно Тогда
			Возврат СтрШаблон("Проводка %1: отрицательная сумма бывает только в сторно.", Номер);
		КонецЕсли;
	КонецЦикла;
	Если Сторно И ЗначениеЗаполнено(Спецификация.Первичка) Тогда
		Возврат "Сторно не несёт первички: оно отменяет чужую.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Спецификация.Первичка) Тогда
		Попытка
			ВыполнитьМанифест(Спецификация.Первичка, Неопределено, Новый Соответствие, Подразделение);
		Исключение
			Возврат "Первичка не проводится: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	Возврат "";

КонецФункции

// ОшибкаСторно: сторно повторяет проводки исходной с обратным знаком.
Функция ОшибкаСторно(Сторно, Исходная)

	Наши = Сторно.Спецификация.Проводки;
	Их = Исходная.Спецификация.Проводки;
	Если Наши.Количество() <> Их.Количество() Тогда
		Возврат СтрШаблон("в сторно %1 проводок, а в операции «%2» — %3", Наши.Количество(), Исходная.Метаданные.Имя, Их.Количество());
	КонецЕсли;
	Для Номер = 0 По Их.Количество() - 1 Цикл
		Наша = Наши[Номер];
		ИхПроводка = Их[Номер];
		Если Наша.Дт <> ИхПроводка.Дт ИЛИ Наша.Кт <> ИхПроводка.Кт ИЛИ Наша.Сумма <> -ИхПроводка.Сумма Тогда
			Возврат СтрШаблон("проводка %1 сторно не повторяет исходную с минусом: ждали Дт %2 Кт %3 %4", Номер + 1, ИхПроводка.Дт, ИхПроводка.Кт, -ИхПроводка.Сумма);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Исходная.Спецификация.Сторнирует) Тогда
		Возврат "сторно сторно не делают: проведите операцию заново";
	КонецЕсли;
	Возврат "";

КонецФункции

// ОшибкаСторноВЖурнале проверяет сторно при записи: исходная учтена, не
// сторно сама и не сторнирована раньше.
Функция ОшибкаСторноВЖурнале(Сторно, Книга)

	Исходная = Кластер.Получить("Операция", Сторно.Спецификация.Сторнирует, Книга.Метаданные.Подразделение);
	Если Исходная = Неопределено ИЛИ ИмяAPI(Исходная.Спецификация.Книга) <> ИмяAPI(Книга.Метаданные.Имя) Тогда
		Возврат СтрШаблон("Операции «%1» в книге нет — сторнировать нечего.", Сторно.Спецификация.Сторнирует);
	КонецЕсли;
	Если Исходная.Состояние.Учтена <> Истина Тогда
		Возврат СтрШаблон("Операция «%1» не учтена: сторнируют только учтённое.", Сторно.Спецификация.Сторнирует);
	КонецЕсли;
	Для Каждого Другая Из ОперацииКниги(Книга) Цикл
		Если ИмяAPI(Другая.Спецификация.Сторнирует) = ИмяAPI(Сторно.Спецификация.Сторнирует)
			И ИмяAPI(Другая.Метаданные.Имя) <> ИмяAPI(Сторно.Метаданные.Имя) Тогда
			Возврат СтрШаблон("Операцию «%1» уже сторнирует «%2».", Сторно.Спецификация.Сторнирует, Другая.Метаданные.Имя);
		КонецЕсли;
	КонецЦикла;
	Ошибка = ОшибкаСторно(Сторно, Исходная);
	Возврат ?(Ошибка = "", "", "Сторно не сходится: " + Ошибка + ".");

КонецФункции

