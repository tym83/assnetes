#Область Помощники

Процедура ПровестиУслугу(Объект, Сайт, Отбор, Имя, Порт, Безголовая)

	У = Новый Услуга(Имя, Сайт.Подразделение);
	У.Спецификация.Отбор.Вставить("app.kubernetes.io/instance", Отбор);
	Если Безголовая Тогда
		У.Спецификация.КластерныйАдрес = "None";
	КонецЕсли;
	П = У.Спецификация.Порты.Добавить();
	П.Порт = Порт;
	Кластер.Провести(У, Объект);

КонецПроцедуры

Процедура Ресурсы(Контейнер, Процессор, Память)

	Контейнер.Ресурсы.Запросы.Процессор = Процессор;
	Контейнер.Ресурсы.Запросы.Память = Память;
	Контейнер.Ресурсы.Пределы.Память = Память;

КонецПроцедуры

Процедура Переменная(Контейнер, Имя, Значение)

	П = Контейнер.Окружение.Добавить();
	П.Имя = Имя;
	П.Значение = Значение;

