// Сайт на 1С-Битрикс.
//
// Поднимает всё, что нужно сайту: базу MySQL (Percona из образов Битрикса),
// Redis для кеша и сессий, веб-кластер из nginx и php-fpm, агентов на cron,
// проходную и сезонный найм. Дистрибутив скачивает с www.1c-bitrix.ru —
// пробная версия на 30 дней — и ждёт, пока человек пройдёт мастер установки.
//
// Веб-кластер устроен как у самого Битрикса без общей папки: первый узел —
// ведущий, на нём живут файлы сайта, туда идут записи (POST, админка); остальные
// узлы — зеркала, они раз в 20 секунд забирают файлы с ведущего и отдают чтение.

#Область ОбработчикиСобытий

&Обработка(Вид = "Сайт", Владеет = "НаборСоСостоянием, Развёртывание, Услуга, Проходная, Справочник, Секрет, СезонныйНайм")
Процедура ОбработкаПроведения(Объект, Отказ) Экспорт

	Сайт = ПараметрыСайта(Объект);
	Состояние = Объект.Состояние;

	Секрет = ПровестиСекретБазы(Объект, Сайт);
	ПровестиБазуДанных(Объект, Сайт);
	ПровестиRedis(Объект, Сайт);
	ПровестиНастройкиNginx(Объект, Сайт);
	ПровестиВебКластер(Объект, Сайт);
	ПровестиПроходную(Объект, Сайт);
	ПровестиСезонныйНайм(Объект, Сайт);

	Состояние.БазаДанных.Сервер = Сайт.Имя + "-mysql";
	Состояние.БазаДанных.База = "bitrix";
	Состояние.БазаДанных.Пользователь = "bitrix";
	Состояние.БазаДанных.Пароль = СтрШаблон("в секрете %1, ключ password", Сайт.Имя + "-bd");
	Состояние.Ведущий = Сайт.Имя + "-veb-0";
	Состояние.Адрес = ?(ЗначениеЗаполнено(Сайт.Домен), "http://" + Сайт.Домен + "/", "");

	Набор = Кластер.Получить("НаборСоСостоянием", Сайт.Имя + "-veb", Сайт.Подразделение);
	Готово = 0;
	Если Набор <> Неопределено И ЗначениеЗаполнено(Набор.Состояние.ГотовыхРеплик) Тогда
		Готово = Набор.Состояние.ГотовыхРеплик;
	КонецЕсли;
	Состояние.Веб = СтрШаблон("%1/%2", Готово, Сайт.Реплики);

	ОпределитьФазу(Объект, Сайт, Готово);

КонецПроцедуры

Процедура ПередУдалением(Объект, Отказ) Экспорт

	// дочерние объекты удалит сборщик мусора: они в собственности сайта;
	// тома базы и файлов остаются — пусть их спишет человек
	Журнал.Информация(СтрШаблон("Сайт «%1» снят с учёта. Тома с файлами и базой оставлены: списывать по акту.",
		Объект.Метаданные.Имя));

КонецПроцедуры

#КонецОбласти

#Область Составные

Функция ПараметрыСайта(Объект)

	Спец = Объект.Спецификация;
	Веб = Спец.Веб;
	База = Спец.БазаДанных;
	Сайт = Новый Структура;
	Сайт.Вставить("Имя", ИмяAPI(Объект.Метаданные.Имя));
	Сайт.Вставить("Подразделение", Объект.Метаданные.Подразделение);
	Сайт.Вставить("Редакция", Значение(Спец.Редакция, "start"));
	Сайт.Вставить("Домен", Значение(Спец.Домен, ""));
	Сайт.Вставить("КлассПроходной", Значение(Спец.КлассПроходной, "nginx"));
	Сайт.Вставить("КлассХранения", Значение(Спец.КлассХранения, ""));
	Сайт.Вставить("Реплики", Значение(Веб.Реплики, 1));
	Сайт.Вставить("МаксимумРеплик", Значение(Веб.МаксимумРеплик, 0));
	Сайт.Вставить("Процессор", Значение(Веб.Процессор, "500m"));
	Сайт.Вставить("Память", Значение(Веб.Память, "1Gi"));
	Сайт.Вставить("Объём", Значение(Веб.Объём, "10Gi"));
	Сайт.Вставить("PHP", Значение(Веб.ВерсияPHP, "8.2"));
	Сайт.Вставить("ПроцессорБазы", Значение(База.Процессор, "500m"));
	Сайт.Вставить("ПамятьБазы", Значение(База.Память, "1Gi"));
	Сайт.Вставить("ОбъёмБазы", Значение(База.Объём, "10Gi"));
	Возврат Сайт;

КонецФункции

Функция Значение(Значение, ПоУмолчанию)

	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);

КонецФункции

Функция ОбразPHP(Сайт)

	Образы = Новый Соответствие;
	Образы.Вставить("8.2", "quay.io/bitrix24/php:8.2.35-fpm-v1-alpine");
	Образы.Вставить("8.3", "quay.io/bitrix24/php:8.3.30-fpm-v1-alpine");
	Образы.Вставить("8.4", "quay.io/bitrix24/php:8.4.17-fpm-v1-alpine");
	Возврат Образы.Получить(Сайт.PHP);

КонецФункции

#КонецОбласти

#Область База

Функция ПровестиСекретБазы(Объект, Сайт)

	Имя = Сайт.Имя + "-bd";
	Секрет = Кластер.Получить("Секрет", Имя, Сайт.Подразделение);
	Если Секрет <> Неопределено Тогда
		Возврат Секрет; // пароли выдаются один раз и не меняются
	КонецЕсли;
	Секрет = Новый Секрет(Имя, Сайт.Подразделение);
	Секрет.СтроковыеДанные.Вставить("root-password", Пароль());
	Секрет.СтроковыеДанные.Вставить("password", Пароль());
	Возврат Кластер.Провести(Секрет, Объект);

КонецФункции

Функция Пароль()

	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

КонецФункции

Процедура ПровестиБазуДанных(Объект, Сайт)

	Имя = Сайт.Имя + "-mysql";
	Набор = Новый НаборСоСостоянием(Имя, Сайт.Подразделение);
	Набор.Метаданные.Метки.Вставить("app.kubernetes.io/component", "mysql");
	Спец = Набор.Спецификация;
	Спец.Реплики = 1;
	Спец.serviceName = Имя;
	Спец.Отбор.ПоМеткам.Вставить("app.kubernetes.io/instance", Имя);
	Шаблон = Спец.Шаблон;
	Шаблон.Метаданные.Метки.Вставить("app.kubernetes.io/instance", Имя);
	Шаблон.Спецификация.КонтекстБезопасности.fsGroup = 1001;

	К = Шаблон.Спецификация.Контейнеры.Добавить();
	К.Имя = "mysql";
	К.Образ = "quay.io/bitrix24/percona-server:8.0.46-v1-rhel";
	Для Каждого Аргумент Из СтрРазделить("--sql-mode=,--character-set-server=utf8mb4,--collation-server=utf8mb4_unicode_ci,--innodb-strict-mode=0,--skip-name-resolve,--transaction-isolation=READ-COMMITTED", ",") Цикл
		К.Аргументы.Добавить(Аргумент);
	КонецЦикла;
	ПеременнаяИзСекрета(К, "MYSQL_ROOT_PASSWORD", Сайт.Имя + "-bd", "root-password");
	ПеременнаяИзСекрета(К, "MYSQL_PASSWORD", Сайт.Имя + "-bd", "password");
	Переменная(К, "MYSQL_DATABASE", "bitrix");
	Переменная(К, "MYSQL_USER", "bitrix");
	Переменная(К, "PERCONA_TELEMETRY_DISABLE", "1");
	Порт = К.Порты.Добавить();
	Порт.Имя = "mysql";
	Порт.ПортКонтейнера = 3306;
	Ресурсы(К, Сайт.ПроцессорБазы, Сайт.ПамятьБазы);
	К.ПробаГотовности.Выполнение.Команда.Добавить("sh");
	К.ПробаГотовности.Выполнение.Команда.Добавить("-c");
	К.ПробаГотовности.Выполнение.Команда.Добавить("mysqladmin ping -uroot -p""$MYSQL_ROOT_PASSWORD"" --silent");
	К.ПробаГотовности.ПериодСекунд = 10;
	Подключить(К, "dannye", "/var/lib/mysql");

	ШаблонТома(Спец, "dannye", Сайт.ОбъёмБазы, Сайт.КлассХранения);
	Кластер.Провести(Набор, Объект);

	ПровестиУслугу(Объект, Сайт, Имя, Имя, 3306, Истина);

КонецПроцедуры

Процедура ПровестиRedis(Объект, Сайт)

	Имя = Сайт.Имя + "-redis";
	Р = Новый Развёртывание(Имя, Сайт.Подразделение);
	Р.Спецификация.Реплики = 1;
	Р.Спецификация.Отбор.ПоМеткам.Вставить("app.kubernetes.io/instance", Имя);
	Р.Спецификация.Шаблон.Метаданные.Метки.Вставить("app.kubernetes.io/instance", Имя);
	К = Р.Спецификация.Шаблон.Спецификация.Контейнеры.Добавить();
	К.Имя = "redis";
	К.Образ = "docker.io/library/redis:8.2.10-alpine";
	К.Аргументы.Добавить("--save");
	К.Аргументы.Добавить("");
	К.Аргументы.Добавить("--maxmemory");
	К.Аргументы.Добавить("200mb");
	К.Аргументы.Добавить("--maxmemory-policy");
	К.Аргументы.Добавить("allkeys-lru");
	Порт = К.Порты.Добавить();
	Порт.ПортКонтейнера = 6379;
	Ресурсы(К, "50m", "256Mi");
	Кластер.Провести(Р, Объект);
	ПровестиУслугу(Объект, Сайт, Имя, Имя, 6379, Ложь);

КонецПроцедуры

#КонецОбласти

#Область ВебКластер

Процедура ПровестиНастройкиNginx(Объект, Сайт)

	Справочник = Новый Справочник(Сайт.Имя + "-nginx", Сайт.Подразделение);
	Справочник.Данные.Вставить("vedushchij.conf", КонфигурацияNginx(Сайт, Ложь));
	Справочник.Данные.Вставить("zerkalo.conf", КонфигурацияNginx(Сайт, Истина));
	Справочник.Данные.Вставить("zz-assnetes.ini", НастройкиPHP());
	Кластер.Провести(Справочник, Объект);

КонецПроцедуры

Процедура ПровестиВебКластер(Объект, Сайт)

	Имя = Сайт.Имя + "-veb";
	Ведущий = Сайт.Имя + "-vedushchij";

	// услуга ведущего: на неё зеркала ходят за файлами и отправляют записи
	Услуга = Новый Услуга(Ведущий, Сайт.Подразделение);
	Услуга.Спецификация.Отбор.Вставить("statefulset.kubernetes.io/pod-name", Имя + "-0");
	Порт = Услуга.Спецификация.Порты.Добавить();
	Порт.Имя = "http";
	Порт.Порт = 8080;
	Порт = Услуга.Спецификация.Порты.Добавить();
	Порт.Имя = "rsync";
	Порт.Порт = 873;
	Кластер.Провести(Услуга, Объект);

	ПровестиУслугу(Объект, Сайт, Имя, Сайт.Имя, 8080, Ложь);
	ПровестиУслугу(Объект, Сайт, Имя, Имя, 8080, Истина);

	Набор = Новый НаборСоСостоянием(Имя, Сайт.Подразделение);
	Набор.Метаданные.Метки.Вставить("app.kubernetes.io/component", "veb");
	Спец = Набор.Спецификация;
	Спец.Реплики = Сайт.Реплики;
	Спец.serviceName = Имя;
	Спец.podManagementPolicy = "OrderedReady";
	Спец.Отбор.ПоМеткам.Вставить("app.kubernetes.io/instance", Имя);
	Шаблон = Спец.Шаблон;
	Шаблон.Метаданные.Метки.Вставить("app.kubernetes.io/instance", Имя);
	ПодСпец = Шаблон.Спецификация;
	ПодСпец.КонтекстБезопасности.fsGroup = 979;

	ОбразPHP = ОбразPHP(Сайт);

	// Поставка: ведущий скачивает дистрибутив, зеркала забирают файлы у ведущего.
	Поставка = ПодСпец.НачальныеКонтейнеры.Добавить();
	Поставка.Имя = "postavka";
	Поставка.Образ = "docker.io/library/alpine:3.22";
	Поставка.Команда.Добавить("sh");
	Поставка.Команда.Добавить("-c");
	Поставка.Команда.Добавить(СкриптПоставки(Сайт, Ведущий));
	Ресурсы(Поставка, "100m", "256Mi");
	Подключить(Поставка, "www", "/opt/www");

	Php = ПодСпец.Контейнеры.Добавить();
	Php.Имя = "php";
	Php.Образ = ОбразPHP;
	Ресурсы(Php, Сайт.Процессор, Сайт.Память);
	Подключить(Php, "www", "/opt/www");
	ПодключитьФайл(Php, "nginx", "/usr/local/etc/php/conf.d/zz-assnetes.ini", "zz-assnetes.ini");

	Nginx = ПодСпец.Контейнеры.Добавить();
	Nginx.Имя = "nginx";
	Nginx.Образ = "quay.io/bitrix24/nginx:1.30.6-v1-alpine";
	Nginx.Команда.Добавить("sh");
	Nginx.Команда.Добавить("-c");
	Nginx.Команда.Добавить("if [ ""${HOSTNAME##*-}"" = 0 ]; then c=vedushchij; else c=zerkalo; fi; exec nginx -c /etc/assnetes/$c.conf -g 'daemon off;'");
	Порт = Nginx.Порты.Добавить();
	Порт.Имя = "http";
	Порт.ПортКонтейнера = 8080;
	Nginx.ПробаГотовности.HTTPЗапрос.Путь = "/healthz";
	Nginx.ПробаГотовности.HTTPЗапрос.Порт = 8080;
	Ресурсы(Nginx, "50m", "128Mi");
	Подключить(Nginx, "www", "/opt/www");
	Подключить(Nginx, "nginx", "/etc/assnetes");

	// Агенты Битрикса — на cron, ровно на одном узле: на ведущем.
	Агенты = ПодСпец.Контейнеры.Добавить();
	Агенты.Имя = "agenty";
	Агенты.Образ = ОбразPHP;
	Агенты.Команда.Добавить("sh");
	Агенты.Команда.Добавить("-c");
	Агенты.Команда.Добавить("[ ""${HOSTNAME##*-}"" = 0 ] || exec sleep infinity; while true; do [ -f /opt/www/bitrix/modules/main/tools/cron_events.php ] && php -f /opt/www/bitrix/modules/main/tools/cron_events.php; sleep 60; done");
	Ресурсы(Агенты, "20m", "256Mi");
	Подключить(Агенты, "www", "/opt/www");
	ПодключитьФайл(Агенты, "nginx", "/usr/local/etc/php/conf.d/zz-assnetes.ini", "zz-assnetes.ini");

	// Синхронизатор: на ведущем раздаёт файлы, на зеркалах забирает.
	Синхр = ПодСпец.Контейнеры.Добавить();
	Синхр.Имя = "sinhronizator";
	Синхр.Образ = "docker.io/library/alpine:3.22";
	Синхр.Команда.Добавить("sh");
	Синхр.Команда.Добавить("-c");
	Синхр.Команда.Добавить(СкриптСинхронизации(Ведущий));
	Ресурсы(Синхр, "20m", "64Mi");
	Подключить(Синхр, "www", "/opt/www");

	Том = ПодСпец.Тома.Добавить();
	Том.Имя = "nginx";
	Том.Справочник.Имя = Сайт.Имя + "-nginx";
	ШаблонТома(Спец, "www", Сайт.Объём, Сайт.КлассХранения);

	Кластер.Провести(Набор, Объект);

КонецПроцедуры

Процедура ПровестиПроходную(Объект, Сайт)

	Если НЕ ЗначениеЗаполнено(Сайт.Домен) Тогда
		Возврат;
	КонецЕсли;
	П = Новый Проходная(Сайт.Имя, Сайт.Подразделение);
	П.Метаданные.Аннотации.Вставить("nginx.ingress.kubernetes.io/proxy-body-size", "1024m");
	П.Спецификация.КлассПроходной = Сайт.КлассПроходной;
	Правило = П.Спецификация.Правила.Добавить();
	Правило.Хост = Сайт.Домен;
	Путь = Правило.HTTP.Пути.Добавить();
	Путь.Путь = "/";
	Путь.ТипПути = "Prefix";
	Путь.Получатель.Услуга.Имя = Сайт.Имя;
	Путь.Получатель.Услуга.Порт.Номер = 8080;
	Кластер.Провести(П, Объект);

КонецПроцедуры

Процедура ПровестиСезонныйНайм(Объект, Сайт)

	Если Сайт.МаксимумРеплик <= Сайт.Реплики Тогда
		Возврат;
	КонецЕсли;
	Н = Новый СезонныйНайм(Сайт.Имя + "-veb", Сайт.Подразделение);
	Н.Спецификация.ЦельМасштабирования.ВерсияAPI = "apps/v1";
	Н.Спецификация.ЦельМасштабирования.Вид = "StatefulSet";
	Н.Спецификация.ЦельМасштабирования.Имя = Сайт.Имя + "-veb";
	Н.Спецификация.МинимумРеплик = Сайт.Реплики;
	Н.Спецификация.МаксимумРеплик = Сайт.МаксимумРеплик;
	Показатель = Н.Спецификация.metrics.Добавить();
	Показатель.Тип = "Resource";
	Показатель.resource.Имя = "cpu";
	Показатель.resource.target.Тип = "Utilization";
	Показатель.resource.target.averageUtilization = 70;
	Кластер.Провести(Н, Объект);

КонецПроцедуры

#КонецОбласти

#Область Фазы

Процедура ОпределитьФазу(Объект, Сайт, Готово)

	Состояние = Объект.Состояние;
	ПовторитьЧерез(60);
	Если Готово = 0 Тогда
		Состояние.Фаза = "Поставка";
		Состояние.Сообщение = "Скачиваю дистрибутив и поднимаю базу. Ждите, касса скоро откроется.";
		Возврат;
	КонецЕсли;

	Ответ = Кластер.ВыполнитьВПоде(Сайт.Имя + "-veb-0", Сайт.Подразделение,
		"test -f /opt/www/bitrix/.settings.php && echo ustanovlen; grep -q BX_CRONTAB_SUPPORT /opt/www/bitrix/php_interface/dbconn.php 2>/dev/null && echo agenty", "php");
	Если СтрНайти(Ответ.Вывод, "ustanovlen") = 0 Тогда
		Состояние.Фаза = "ОжидаетМастерУстановки";
		Состояние.Сообщение = СтрШаблон("Дистрибутив разложен. Пройдите мастер установки%1. База: сервер %2, база bitrix, пользователь bitrix, пароль — в секрете %3.",
			?(ЗначениеЗаполнено(Сайт.Домен), " на http://" + Сайт.Домен + "/", ""), Сайт.Имя + "-mysql", Сайт.Имя + "-bd");
		Возврат;
	КонецЕсли;

	Если СтрНайти(Ответ.Вывод, "agenty") = 0 Тогда
		ПеревестиАгентыНаCron(Сайт);
	КонецЕсли;
	Состояние.Агенты = "на cron, на ведущем узле";
	Если НЕ ЗначениеЗаполнено(Состояние.Установлен) Тогда
		Состояние.Установлен = XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z";
	КонецЕсли;
	Состояние.Фаза = "Работает";
	Состояние.Сообщение = СтрШаблон("Сайт работает, узлов %1 из %2.", Готово, Сайт.Реплики);
	ПовторитьЧерез(600);

КонецПроцедуры

// Агенты Битрикса по умолчанию выполняются «на хитах» — на запросах
// посетителей. В кластере их выполняет cron ведущего узла.
Процедура ПеревестиАгентыНаCron(Сайт)

	Скрипт = "f=/opt/www/bitrix/php_interface/dbconn.php; grep -q BX_CRONTAB_SUPPORT $f || sed -i '1a define(""BX_CRONTAB_SUPPORT"", true);' $f";
	Ответ = Кластер.ВыполнитьВПоде(Сайт.Имя + "-veb-0", Сайт.Подразделение, Скрипт, "php");
	Если Ответ.КодВозврата = 0 Тогда
		Журнал.Информация(СтрШаблон("Сайт «%1»: агенты переведены на cron", Сайт.Имя));
	Иначе
		Журнал.Предупреждение(СтрШаблон("Сайт «%1»: агенты не переведены на cron: %2", Сайт.Имя, Ответ.Ошибки));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тексты

Функция СкриптПоставки(Сайт, Ведущий)

	Возврат СтрШаблон("set -e
		|if [ ""${HOSTNAME##*-}"" = 0 ]; then
		|  if [ -e /opt/www/bitrix ] || [ -e /opt/www/index.php ]; then echo 'Файлы сайта на месте'; exit 0; fi
		|  echo 'Скачиваю дистрибутив %1'
		|  wget -q -O /tmp/bitrix.tar.gz https://www.1c-bitrix.ru/download/%2
		|  tar -xzf /tmp/bitrix.tar.gz -C /opt/www
		|  rm -f /tmp/bitrix.tar.gz
		|  chown -R 979:979 /opt/www
		|  echo 'Дистрибутив разложен'
		|else
		|  apk add --no-cache rsync >/dev/null
		|  until rsync -a --delete rsync://%3:873/www/ /opt/www/; do echo 'Жду ведущего'; sleep 5; done
		|  echo 'Файлы взяты у ведущего'
		|fi", Сайт.Редакция, ИмяАрхива(Сайт.Редакция), Ведущий);

КонецФункции

Функция ИмяАрхива(Редакция)

	Если СтрНачинаетсяС(Редакция, "bitrix24") Тогда
		Возврат "portal/" + Редакция + "_encode.tar.gz";
	КонецЕсли;
	Возврат Редакция + "_encode.tar.gz";

КонецФункции

Функция СкриптСинхронизации(Ведущий)

	Возврат СтрШаблон("apk add --no-cache rsync >/dev/null
		|if [ ""${HOSTNAME##*-}"" = 0 ]; then
		|  printf '[www]\npath = /opt/www\nread only = yes\nuid = 979\ngid = 979\n' > /tmp/rsyncd.conf
		|  exec rsync --daemon --no-detach --config=/tmp/rsyncd.conf --port=873
		|fi
		|while true; do
		|  rsync -a --delete --exclude=/bitrix/cache/ --exclude=/bitrix/managed_cache/ --exclude=/bitrix/stack_cache/ rsync://%1:873/www/ /opt/www/ || echo 'Ведущий не ответил'
		|  sleep 20
		|done", Ведущий);

КонецФункции

Функция КонфигурацияNginx(Сайт, Зеркало)

	// На зеркалах файлы только для чтения: записи и админка уходят к ведущему.
	Админка = "";
	Записи = "";
	Если Зеркало Тогда
		Админка = "
			|        location ^~ /bitrix/admin/ {
			|            proxy_pass http://vedushchij;
			|            proxy_set_header Host $host;
			|            proxy_set_header X-Real-IP $remote_addr;
			|            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			|        }";
		Записи = "
			|            if ($request_method !~ ^(GET|HEAD)$) { proxy_pass http://vedushchij; }";
	КонецЕсли;
	Возврат СтрШаблон("worker_processes auto;
		|pid /tmp/nginx.pid;
		|error_log /dev/stderr warn;
		|events { worker_connections 1024; }
		|http {
		|    include /etc/nginx/mime.types;
		|    default_type application/octet-stream;
		|    access_log /dev/stdout;
		|    sendfile on;
		|    client_max_body_size 1024m;
		|    client_body_temp_path /tmp/client_body;
		|    fastcgi_temp_path /tmp/fastcgi;
		|    proxy_temp_path /tmp/proxy;
		|    uwsgi_temp_path /tmp/uwsgi;
		|    scgi_temp_path /tmp/scgi;
		|    upstream vedushchij { server %1.%2.svc:8080; }
		|    server {
		|        listen 8080;
		|        root /opt/www;
		|        index index.php index.html;
		|        location = /healthz { access_log off; return 200 ""кофта на стуле\n""; }
		|        location ~ /\. { deny all; }
		|        location ~* ^/bitrix/(modules|php_interface|backup|local)/ { deny all; }%3
		|        location ~ \.php$ {%4
		|            try_files $uri @bitrix;
		|            fastcgi_pass 127.0.0.1:9000;
		|            include fastcgi_params;
		|            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
		|            fastcgi_read_timeout 300;
		|        }
		|        location / {%4
		|            try_files $uri $uri/ @bitrix;
		|        }
		|        location @bitrix {
		|            fastcgi_pass 127.0.0.1:9000;
		|            include fastcgi_params;
		|            fastcgi_param SCRIPT_FILENAME $document_root/bitrix/urlrewrite.php;
		|        }
		|    }
		|}
		|", Сайт.Имя + "-vedushchij", Сайт.Подразделение, Админка, Записи);

КонецФункции

Функция НастройкиPHP()

	Возврат "; Настройки, которых ждёт Битрикс
		|short_open_tag = On
		|memory_limit = 512M
		|max_input_vars = 10000
		|post_max_size = 1024M
		|upload_max_filesize = 1024M
		|date.timezone = Europe/Moscow
		|display_errors = Off
		|opcache.revalidate_freq = 0
		|opcache.max_accelerated_files = 100000
		|xdebug.mode = off
		|session.save_path = /tmp
		|";

КонецФункции

