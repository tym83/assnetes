Процедура ПеременнаяИзСекрета(Контейнер, Имя, Секрет, Ключ)

	П = Контейнер.Окружение.Добавить();
	П.Имя = Имя;
	П.ЗначениеИз.СсылкаНаКлючСекрета.Имя = Секрет;
	П.ЗначениеИз.СсылкаНаКлючСекрета.Ключ = Ключ;

