// Удаление помеченных объектов.
//
// «1сctl пометить» только ставит пометку на удаление — аннотацию
// «оркестратор.бух/пометка-удаления». Удаляет эта обработка, раз в час, как
// ночная «Удаление помеченных объектов» в 1С: объект удаляется, только если
// на него никто не ссылается. Иначе он остаётся, а в событиях объекта
// появляется список тех, кто на него ссылается.

#Область ОбработчикиСобытий

&Расписание("17 * * * *")
Процедура УдалитьПомеченные() Экспорт

	Удалено = 0;
	Оставлено = 0;
	Для Каждого Вид Из ПроверяемыеВиды() Цикл
		Для Каждого Объект Из Кластер.Выбрать(Вид) Цикл
			Если НЕ ЗначениеЗаполнено(Объект.Метаданные.Аннотации.Получить("оркестратор.бух/пометка-удаления")) Тогда
				Продолжить;
			КонецЕсли;
			Ссылки = НайтиСсылки(Вид, Объект);
			Имя = Объект.Метаданные.Имя;
			Подразделение = Объект.Метаданные.Подразделение;
			Если Ссылки.Количество() = 0 Тогда
				Кластер.Удалить(Вид, Имя, Подразделение);
				Журнал.Информация(СтрШаблон("Удалён помеченный объект: %1 «%2» (%3)", Вид, Имя, Подразделение));
				Удалено = Удалено + 1;
			Иначе
				Кластер.ЗаписатьСобытие(Объект, "Предупреждение", "НеУдалён",
					СтрШаблон("Объект не может быть удалён, на него есть ссылки (%1): %2",
						Ссылки.Количество(), СтрСоединить(Ссылки, "; ")));
				Оставлено = Оставлено + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Удалено + Оставлено > 0 Тогда
		Журнал.Информация(СтрШаблон("Удаление помеченных завершено: удалено %1, не удалено из-за ссылок %2", Удалено, Оставлено));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверяемыеВиды()

	Возврат СтрРазделить("Справочник,Секрет,ЗаявкаНаТом,Услуга,Развёртывание,НаборСоСостоянием,ПодотчётноеЛицо", ",");

КонецФункции

// Возвращает Массив строк вида «Под «имя»» — тех, кто ссылается на объект.
Функция НайтиСсылки(Вид, Объект)

	Ссылки = Новый Массив;
	Имя = ИмяAPI(Объект.Метаданные.Имя);
	Подразделение = Объект.Метаданные.Подразделение;

	Если Вид = "Справочник" ИЛИ Вид = "Секрет" ИЛИ Вид = "ЗаявкаНаТом" ИЛИ Вид = "ПодотчётноеЛицо" Тогда
		Для Каждого Под Из Кластер.Выбрать("Под", , Подразделение) Цикл
			Если ПодСсылаетсяНа(Под, Вид, Имя) Тогда
				Ссылки.Добавить("Под «" + Под.Метаданные.Имя + "»");
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Вид = "Услуга" Тогда
		Для Каждого Проходная Из Кластер.Выбрать("Проходная", , Подразделение) Цикл
			Для Каждого Правило Из Проходная.Спецификация.Правила Цикл
				Для Каждого Путь Из Правило.HTTP.Пути Цикл
					Если ИмяAPI(Путь.Получатель.Услуга.Имя) = Имя Тогда
						Ссылки.Добавить("Проходная «" + Проходная.Метаданные.Имя + "»");
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли Вид = "Развёртывание" ИЛИ Вид = "НаборСоСостоянием" Тогда
		Для Каждого Найм Из Кластер.Выбрать("СезонныйНайм", , Подразделение) Цикл
			Цель = Найм.Спецификация.ЦельМасштабирования;
			Если ИмяAPI(Цель.Имя) = Имя Тогда
				Ссылки.Добавить("СезонныйНайм «" + Найм.Метаданные.Имя + "»");
			КонецЕсли;
		КонецЦикла;
		Метки = Объект.Спецификация.Шаблон.Метаданные.Метки;
		Для Каждого Услуга Из Кластер.Выбрать("Услуга", , Подразделение) Цикл
			Отбор = Услуга.Спецификация.Отбор;
			Если Отбор.Количество() > 0 И ОтборПодходит(Отбор, Метки) Тогда
				Ссылки.Добавить("Услуга «" + Услуга.Метаданные.Имя + "»");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Ссылки;

КонецФункции

Функция ПодСсылаетсяНа(Под, Вид, Имя)

	Спецификация = Под.Спецификация;
	Если Вид = "ПодотчётноеЛицо" Тогда
		Возврат ИмяAPI(Спецификация.ПодотчётноеЛицо) = Имя;
	КонецЕсли;

	Для Каждого Том Из Спецификация.Тома Цикл
		Если Вид = "Справочник" И Том.Свойство("Справочник") И ИмяAPI(Том.Справочник.Имя) = Имя Тогда
			Возврат Истина;
		ИначеЕсли Вид = "Секрет" И Том.Свойство("Секрет") И ИмяAPI(Том.Секрет.ИмяСекрета) = Имя Тогда
			Возврат Истина;
		ИначеЕсли Вид = "ЗаявкаНаТом" И Том.Свойство("ЗаявкаНаТом") И ИмяAPI(Том.ЗаявкаНаТом.ИмяЗаявки) = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Контейнер Из Спецификация.Контейнеры Цикл
		Для Каждого Переменная Из Контейнер.Окружение Цикл
			Источник = Переменная.ЗначениеИз;
			Если Вид = "Справочник" И Источник.Свойство("СсылкаНаКлючСправочника")
				И ИмяAPI(Источник.СсылкаНаКлючСправочника.Имя) = Имя Тогда
				Возврат Истина;
			ИначеЕсли Вид = "Секрет" И Источник.Свойство("СсылкаНаКлючСекрета")
				И ИмяAPI(Источник.СсылкаНаКлючСекрета.Имя) = Имя Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Источник Из Контейнер.ОкружениеИз Цикл
			Если Вид = "Справочник" И Источник.Свойство("configMapRef") И ИмяAPI(Источник.configMapRef.Имя) = Имя Тогда
				Возврат Истина;
			ИначеЕсли Вид = "Секрет" И Источник.Свойство("secretRef") И ИмяAPI(Источник.secretRef.Имя) = Имя Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Вид = "Секрет" Тогда
		Для Каждого Секрет Из Спецификация.imagePullSecrets Цикл
			Если ИмяAPI(Секрет.Имя) = Имя Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ОтборПодходит(Отбор, Метки)

	Для Каждого Условие Из Отбор Цикл
		Если Метки.Получить(Условие.Ключ) <> Условие.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти
