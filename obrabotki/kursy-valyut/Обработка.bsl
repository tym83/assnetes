// Курсы валют.
//
// Раз в час берёт курсы ЦБ РФ и считает, во что обходится каждое подразделение
// кластера: по запросам ресурсов его подов и прайсу за ядро и гигабайт в час.
// Итог — в рублях и в валютах, которые указаны в спецификации.

#Область ОбработчикиСобытий

&Обработка(Вид = "КурсыВалют")
Процедура ОбработкаПроведения(Объект, Отказ) Экспорт

	Попытка
		Курсы = ЗагрузитьКурсы(Объект);
	Исключение
		Отказ = Истина;
		Сообщить("ЦБ не ответил: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ". Курсы прежние.");
		ПовторитьЧерез(900);
		Возврат;
	КонецПопытки;

	Расходы = РасходыПоПодразделениям(Объект.Спецификация);
	Итого = 0;
	Для Каждого Строка Из Расходы Цикл
		Итого = Итого + Строка.РублейВМесяц;
	КонецЦикла;

	Состояние = Объект.Состояние;
	Состояние.НаДату = Курсы.НаДату;
	Состояние.Курсы = Курсы.Курсы;
	Состояние.Расходы = ВМассив(Расходы, Курсы.Курсы);
	Состояние.ИтогоРублейВМесяц = Окр(Итого, 2);
	Состояние.Сообщение = СтрШаблон("Курсы ЦБ на %1. Подразделений: %2, итого %3 руб. в месяц",
		Курсы.НаДату, Расходы.Количество(), Формат(Итого, "ЧДЦ=2"));

КонецПроцедуры

&Расписание("0 * * * *")
Процедура ПересчитатьВсе() Экспорт

	Для Каждого Объект Из Кластер.Выбрать("КурсыВалют") Цикл
		Отказ = Ложь;
		ОбработкаПроведения(Объект, Отказ);
		Если НЕ Отказ Тогда
			Кластер.ЗаписатьСостояние(Объект);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает Структура(НаДату, Курсы — массив структур Валюта, Название, Курс).
Функция ЗагрузитьКурсы(Объект)

	Источник = Объект.Спецификация.Источник;
	Если НЕ ЗначениеЗаполнено(Источник) Тогда
		Источник = "https://www.cbr.ru";
	КонецЕсли;
	Нужные = Новый Соответствие;
	Для Каждого Код Из Объект.Спецификация.Валюты Цикл
		Нужные.Вставить(ВРег(Код), Истина);
	КонецЦикла;

	Соединение = Новый HTTPСоединение(Источник, , , , , 30);
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/scripts/XML_daily.asp"));
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("код ответа %1", Ответ.КодСостояния);
	КонецЕсли;

	Результат = Новый Структура("НаДату, Курсы", "", Новый Массив);
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Валюта = Неопределено;
	Поле = "";
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Поле = Чтение.Имя;
			Если Поле = "ValCurs" Тогда
				Результат.НаДату = Чтение.ЗначениеАтрибута("Date");
			ИначеЕсли Поле = "Valute" Тогда
				Валюта = Новый Структура("Код, Название, Номинал, Значение", "", "", 1, 0);
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст И Валюта <> Неопределено Тогда
			Если Поле = "CharCode" Тогда
				Валюта.Код = Чтение.Значение;
			ИначеЕсли Поле = "Name" Тогда
				Валюта.Название = Чтение.Значение;
			ИначеЕсли Поле = "Nominal" Тогда
				Валюта.Номинал = Число(Чтение.Значение);
			ИначеЕсли Поле = "Value" Тогда
				Валюта.Значение = Число(Чтение.Значение);
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Valute" Тогда
			Если Нужные.Количество() = 0 ИЛИ Нужные.Получить(Валюта.Код) = Истина Тогда
				Результат.Курсы.Добавить(Новый Структура("Валюта, Название, Курс",
					Валюта.Код, Валюта.Название, Окр(Валюта.Значение / Валюта.Номинал, 4)));
			КонецЕсли;
			Валюта = Неопределено;
		КонецЕсли;
	КонецЦикла;

	Если Результат.Курсы.Количество() = 0 Тогда
		ВызватьИсключение "в ответе нет ни одного курса";
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает ТаблицаЗначений: Подразделение, Ядер, ГигабайтПамяти, РублейВМесяц.
Функция РасходыПоПодразделениям(Спецификация)

	ЦенаЯдра = ?(ЗначениеЗаполнено(Спецификация.ЦенаЯдраВЧас), Спецификация.ЦенаЯдраВЧас, 1.2);
	ЦенаГигабайта = ?(ЗначениеЗаполнено(Спецификация.ЦенаГигабайтаВЧас), Спецификация.ЦенаГигабайтаВЧас, 0.3);
	ЧасовВМесяце = 730;
	Гигабайт = 1024 * 1024 * 1024;

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Подразделение");
	Таблица.Колонки.Добавить("Ядер");
	Таблица.Колонки.Добавить("ГигабайтПамяти");

	Для Каждого Под Из Кластер.Выбрать("Под") Цикл
		Фаза = Под.Состояние.Фаза;
		Если Фаза <> "Running" И Фаза <> "Pending" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Контейнер Из Под.Спецификация.Контейнеры Цикл
			Запросы = Контейнер.Ресурсы.Запросы;
			Строка = Таблица.Добавить();
			Строка.Подразделение = Под.Метаданные.Подразделение;
			Строка.Ядер = РазобратьКоличество(Запросы.Получить("Процессор"));
			Строка.ГигабайтПамяти = РазобратьКоличество(Запросы.Получить("Память")) / Гигабайт;
		КонецЦикла;
	КонецЦикла;

	Таблица.Свернуть("Подразделение", "Ядер, ГигабайтПамяти");
	Таблица.Колонки.Добавить("РублейВМесяц");
	Для Каждого Строка Из Таблица Цикл
		Строка.РублейВМесяц = Окр((Строка.Ядер * ЦенаЯдра + Строка.ГигабайтПамяти * ЦенаГигабайта) * ЧасовВМесяце, 2);
		Строка.Ядер = Окр(Строка.Ядер, 3);
		Строка.ГигабайтПамяти = Окр(Строка.ГигабайтПамяти, 3);
	КонецЦикла;
	Таблица.Сортировать("РублейВМесяц Убыв");
	Возврат Таблица;

КонецФункции

Функция ВМассив(Таблица, Курсы)

	Результат = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		ВВалютах = Новый Соответствие;
		Для Каждого Курс Из Курсы Цикл
			ВВалютах.Вставить(Курс.Валюта, Формат(Строка.РублейВМесяц / Курс.Курс, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
		КонецЦикла;
		Результат.Добавить(Новый Структура("Подразделение, Ядер, ГигабайтПамяти, РублейВМесяц, ВВалютах",
			Строка.Подразделение, Строка.Ядер, Строка.ГигабайтПамяти, Строка.РублейВМесяц, ВВалютах));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
