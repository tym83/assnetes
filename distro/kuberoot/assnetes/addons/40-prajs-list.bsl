// Подписка узла на прайс-лист 1Ж: kinit проводит её при загрузке, и
// пакетный менеджер узла находит в нём kuberoot-assnetes, а с ним всё
// остальное. Ключ прайс-листа подставляет сборка (hack/kuberoot.sh).
//
// На узле kuberoot пакетный менеджер ведёт свои виды под kubepkg.dev,
// поэтому вид указан как есть, без перевода.

Прайс = Новый ОбъектКластера("Repository", "прайс-лист");
Прайс.ВерсияAPI = "kubepkg.dev/v1";
Прайс.Спецификация.url = "https://tym83.github.io/assnetes/index.yaml";
Прайс.Спецификация.interval = "10m";
Прайс.Спецификация.publicKeys = Новый Массив;
Прайс.Спецификация.publicKeys.Добавить(Параметры.Ключ);
Провести(Прайс);
